<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Curated original fine art paintings, photography, and sculptures at ART STUDIO.">
    <meta property="og:title" content="The Complete Archive | ART STUDIO">
    <meta property="og:description" content="Curated original fine art paintings, photography, and sculptures at ART STUDIO.">
    <title>The Complete Archive | ART STUDIO</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Playfair+Display:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --ink: #0a0a0a;
            --ink-soft: #404040;
            --muted: #666666;
            --border: #dcdcdc;
            --card-border: #e5e5e5;
            --surface: #ffffff;
            --canvas: #fafafa;
            --gold: #a3702b;
            --gold-bright: #d4af37;
            --green: #047857;
            --font-sans: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            --font-serif: "Playfair Display", Georgia, serif;
            --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
        }

        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }

        body {
            margin: 0;
            font-family: var(--font-sans);
            background: var(--surface);
            color: var(--ink);
            -webkit-font-smoothing: antialiased;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        a { color: inherit; text-decoration: none; }
        button { font: inherit; }
        img { max-width: 100%; display: block; }

        /* Top Announcement Bar */
        .topbar {
            background: #111111;
            color: #ffffff;
            text-align: center;
            padding: 9px 16px;
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }

        /* Sticky Navigation Header */
        .header {
            background: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(8px);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 40;
        }

        .header-inner {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 32px;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
        }

        .mobile-toggle {
            display: none;
            background: none;
            border: none;
            padding: 6px;
            margin-left: -6px;
            color: var(--ink);
            cursor: pointer;
        }

        .brand-mark {
            font-family: var(--font-serif);
            font-size: 26px;
            font-weight: 400;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--ink);
            white-space: nowrap;
            flex-shrink: 0;
        }

        .nav {
            display: flex;
            align-items: center;
            gap: 28px;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--ink-soft);
        }

        .nav a {
            white-space: nowrap;
            padding: 4px 0;
            transition: color 0.15s ease;
        }

        .nav a:hover,
        .nav a.active {
            color: var(--ink);
            text-decoration: underline;
            text-underline-offset: 6px;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-shrink: 0;
        }

        .header-search {
            display: flex;
            align-items: center;
            border: 1px solid #d4d4d4;
            background: #fafafa;
            padding: 6px 10px;
            border-radius: 2px;
            transition: border-color 0.15s ease;
        }

        .header-search:focus-within {
            border-color: var(--ink);
            background: #ffffff;
        }

        .header-search input {
            border: none;
            background: transparent;
            font-family: var(--font-sans);
            font-size: 12px;
            color: var(--ink);
            width: 170px;
            outline: none;
        }

        .header-search input::placeholder {
            color: #999999;
        }

        .header-search button {
            background: none;
            border: none;
            padding: 0 0 0 6px;
            color: #666666;
            cursor: pointer;
            display: flex;
            align-items: center;
        }

        .header-search button:hover {
            color: var(--ink);
        }

        .bag-trigger {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            font-size: 12px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--ink);
            border-radius: 2px;
            white-space: nowrap;
            transition: background-color 0.15s ease;
        }

        .bag-trigger:hover {
            background: #f5f5f5;
        }

        .bag-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 20px;
            height: 20px;
            border-radius: 9999px;
            background: #171717;
            color: #ffffff;
            font-family: var(--font-mono);
            font-size: 11px;
            font-weight: 600;
        }

        .mobile-drawer {
            display: none;
            border-top: 1px solid var(--card-border);
            background: #ffffff;
            padding: 16px 24px 20px;
        }

        .mobile-drawer.open {
            display: block;
        }

        .mobile-drawer-links {
            display: flex;
            flex-direction: column;
            gap: 12px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.14em;
        }

        /* Main Container */
        .main-wrap {
            max-width: 1280px;
            width: 100%;
            margin: 0 auto;
            padding: 44px 24px 72px;
            flex: 1;
        }

        /* Editorial Shop Archive Hero */
        .archive-hero {
            padding-bottom: 36px;
            margin-bottom: 32px;
            border-bottom: 1px solid var(--border);
            display: grid;
            grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
            gap: 32px;
            align-items: center;
        }

        .hero-kicker {
            display: block;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            color: var(--gold);
            margin-bottom: 8px;
        }

        .archive-title {
            font-family: var(--font-serif);
            font-size: clamp(2.25rem, 4.2vw, 3rem);
            font-weight: 400;
            line-height: 1.1;
            letter-spacing: -0.02em;
            color: var(--ink);
            margin: 0 0 12px;
            text-wrap: balance;
        }

        .archive-lead {
            font-size: 14px;
            line-height: 1.65;
            color: #525252;
            max-width: 560px;
            margin: 0;
        }

        .archive-meta {
            margin-top: 16px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px;
            font-size: 12px;
            color: #666666;
        }

        .archive-meta .mono-count {
            font-family: var(--font-mono);
            font-variant-numeric: tabular-nums;
            color: var(--ink);
            font-weight: 500;
        }

        .archive-meta .stock-note {
            color: var(--green);
            font-weight: 500;
        }

        .hero-visual {
            position: relative;
            aspect-ratio: 16 / 9;
            border: 1px solid #d4d4d4;
            border-radius: 2px;
            overflow: hidden;
            background: #f5f5f5;
        }

        .hero-visual img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Filter & Sort Toolbar (Northstar Discipline + House Style) */
        .filter-toolbar {
            padding-bottom: 24px;
            margin-bottom: 32px;
            border-bottom: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .filter-row {
            display: flex;
            align-items: center;
            gap: 8px;
            overflow-x: auto;
            padding-bottom: 2px;
        }

        .filter-row-between {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }

        .filter-label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #525252;
            margin-right: 4px;
            flex-shrink: 0;
        }

        .disc-btn {
            padding: 8px 14px;
            min-height: 36px;
            font-size: 11px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            border: none;
            border-radius: 2px;
            background: #e3e3e3;
            color: #404040;
            cursor: pointer;
            white-space: nowrap;
            flex-shrink: 0;
            transition: background-color 0.15s ease, color 0.15s ease;
        }

        .disc-btn:hover {
            background: #d8d8d8;
            color: var(--ink);
        }

        .disc-btn.active {
            background: #0a0a0a;
            color: #ffffff;
        }

        .artist-row {
            display: flex;
            align-items: center;
            gap: 4px;
            overflow-x: auto;
            flex: 1;
            min-width: 0;
        }

        .artist-btn {
            background: none;
            border: none;
            padding: 6px 10px;
            min-height: 32px;
            font-size: 12px;
            color: #666666;
            cursor: pointer;
            white-space: nowrap;
            flex-shrink: 0;
            transition: color 0.15s ease;
        }

        .artist-btn:hover {
            color: var(--ink);
        }

        .artist-btn.active {
            color: var(--ink);
            font-weight: 700;
            text-decoration: underline;
            text-underline-offset: 5px;
        }

        .sort-wrap {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }

        .sort-select {
            font-family: var(--font-sans);
            font-size: 12px;
            color: var(--ink);
            background: #ffffff;
            border: 1px solid #d4d4d4;
            border-radius: 2px;
            padding: 6px 10px;
            cursor: pointer;
        }

        /* 4-Column Archive Product Grid */
        .product-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 24px;
        }

        .art-card {
            display: flex;
            flex-direction: column;
            background: #ffffff;
            border: 1px solid var(--card-border);
            border-radius: 2px;
            overflow: hidden;
            transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
        }

        .art-card:hover {
            border-color: #999999;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.07);
            transform: translateY(-2px);
        }

        .art-thumb {
            position: relative;
            aspect-ratio: 4 / 5;
            width: 100%;
            background: #ffffff;
            overflow: hidden;
        }

        .art-thumb a {
            position: absolute;
            inset: 0;
            display: block;
        }

        .art-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .art-card:hover .art-thumb img {
            transform: scale(1.03);
        }

        .status-tag {
            position: absolute;
            top: 12px;
            left: 12px;
            z-index: 2;
            font-family: var(--font-mono);
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            background: rgba(255, 255, 255, 0.95);
            color: #262626;
            padding: 3px 8px;
            border: 1px solid #d4d4d4;
            border-radius: 2px;
            pointer-events: none;
        }

        .quick-add-wrap {
            position: absolute;
            left: 12px;
            right: 12px;
            bottom: 12px;
            z-index: 3;
            opacity: 0;
            pointer-events: none;
            transform: translateY(8px);
            transition: opacity 0.2s ease, transform 0.2s ease;
        }

        .art-card:hover .quick-add-wrap,
        .art-card:focus-within .quick-add-wrap {
            opacity: 1;
            pointer-events: auto;
            transform: translateY(0);
        }

        @media (hover: none), (max-width: 1024px) {
            .quick-add-wrap {
                opacity: 1;
                pointer-events: auto;
                transform: translateY(0);
            }
        }

        .quick-add-btn {
            width: 100%;
            background: rgba(10, 10, 10, 0.95);
            color: #ffffff;
            border: none;
            border-radius: 2px;
            padding: 11px 14px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background-color 0.15s ease;
        }

        .quick-add-btn:hover {
            background: #000000;
        }

        .art-body {
            padding: 16px;
            display: flex;
            flex-direction: column;
            flex: 1;
            justify-content: space-between;
            gap: 12px;
            background: #ffffff;
        }

        .art-artist {
            display: block;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.18em;
            color: #666666;
            margin-bottom: 4px;
        }

        .art-title {
            margin: 0;
            font-size: 14px;
            font-weight: 500;
            line-height: 1.35;
            color: var(--ink);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .art-dims {
            margin: 4px 0 0;
            font-size: 12px;
            color: #737373;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .art-price-row {
            padding-top: 10px;
            border-top: 1px solid #e2e2e2;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .art-price {
            font-family: var(--font-mono);
            font-variant-numeric: tabular-nums;
            font-size: 14px;
            font-weight: 600;
            color: var(--ink);
        }

        .empty-state {
            text-align: center;
            padding: 64px 24px;
            border: 1px solid var(--card-border);
            background: var(--canvas);
        }

        .empty-state h2 {
            font-family: var(--font-serif);
            font-weight: 400;
            font-size: 26px;
            margin: 0 0 10px;
        }

        .empty-state p {
            color: var(--muted);
            font-size: 14px;
            margin: 0 0 20px;
        }

        .reset-btn {
            display: inline-block;
            padding: 12px 22px;
            background: var(--ink);
            color: #ffffff;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            border: none;
            cursor: pointer;
        }

        /* Dark Editorial Footer (Matching Northstar) */
        .footer {
            background: #111111;
            color: #999999;
            border-top: 1px solid #262626;
            padding: 56px 0 48px;
            margin-top: auto;
        }

        .footer-inner {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
        }

        .footer-newsletter {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 32px;
            padding-bottom: 44px;
            border-bottom: 1px solid #262626;
            align-items: center;
        }

        .footer-kicker {
            display: block;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            color: var(--gold-bright);
        }

        .footer-heading {
            font-family: var(--font-serif);
            font-size: clamp(1.5rem, 2.5vw, 1.875rem);
            font-weight: 400;
            color: #ffffff;
            margin: 6px 0 0;
            letter-spacing: -0.01em;
        }

        .footer-sub {
            font-size: 12px;
            color: #8c8c8c;
            margin: 8px 0 0;
            max-width: 440px;
            line-height: 1.6;
        }

        .newsletter-form {
            display: flex;
            gap: 8px;
            max-width: 440px;
            width: 100%;
            margin-left: auto;
        }

        .newsletter-form input {
            flex: 1;
            background: #1a1a1a;
            border: 1px solid #333333;
            color: #ffffff;
            padding: 10px 14px;
            font-size: 12px;
            border-radius: 2px;
            outline: none;
        }

        .newsletter-form input:focus {
            border-color: #ffffff;
        }

        .newsletter-form button {
            padding: 10px 20px;
            background: #ffffff;
            color: #000000;
            border: none;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            border-radius: 2px;
            cursor: pointer;
            flex-shrink: 0;
        }

        .newsletter-form button:hover {
            background: #e5e5e5;
        }

        .newsletter-msg {
            font-size: 12px;
            color: #10b981;
            margin: 8px 0 0;
            text-align: right;
        }

        .footer-cols {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 32px;
            padding: 44px 0;
            border-bottom: 1px solid #262626;
            font-size: 12px;
        }

        .footer-col h4 {
            color: #ffffff;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            margin: 0 0 16px;
        }

        .footer-col ul {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .footer-col a:hover {
            color: #ffffff;
        }

        .crypto-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 14px;
            font-family: var(--font-mono);
            font-size: 10px;
            font-weight: 600;
        }

        .crypto-tag {
            background: #1a1a1a;
            border: 1px solid #333333;
            padding: 4px 10px;
            border-radius: 2px;
        }

        .footer-bottom {
            padding-top: 28px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            font-size: 11px;
            color: #737373;
        }

        .hidden { display: none !important; }

        @media (max-width: 1024px) {
            .nav, .header-search { display: none; }
            .mobile-toggle { display: inline-flex; }
            .archive-hero { grid-template-columns: 1fr; }
            .product-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
            .footer-newsletter { grid-template-columns: 1fr; }
            .newsletter-form { margin-left: 0; }
            .newsletter-msg { text-align: left; }
        }

        @media (max-width: 768px) {
            .product-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 14px;
            }
            .footer-cols { grid-template-columns: repeat(2, 1fr); }
        }

        @media (max-width: 520px) {
            .main-wrap { padding: 28px 16px 56px; }
            .header-inner { padding: 0 16px; }
            .brand-mark { font-size: 20px; }
            .footer-bottom { flex-direction: column; align-items: flex-start; }
        }
    </style>
</head>
<body data-cid="<%= cid %>">

    <div class="topbar">Insured Fine Art Courier Delivery · Pay Direct with BTC, ETH, or SOL</div>

    <header class="header">
        <div class="header-inner">
            <div class="header-left">
                <button type="button" class="mobile-toggle" id="menuToggle" aria-label="Toggle navigation menu">
                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                </button>
                <a href="/" class="brand-mark">ART STUDIO</a>
            </div>

            <nav class="nav" aria-label="Primary navigation">
                <a href="/" class="<%= active_category === 'All' ? 'active' : '' %>">Shop All</a>
                <a href="/?category=Painting" class="<%= active_category === 'Painting' ? 'active' : '' %>">Paintings</a>
                <a href="/?category=Photography" class="<%= active_category === 'Photography' ? 'active' : '' %>">Photography</a>
                <a href="/?category=Sculpture" class="<%= active_category === 'Sculpture' ? 'active' : '' %>">Sculpture</a>
                <a href="/?category=Furniture" class="<%= active_category === 'Furniture' ? 'active' : '' %>">Furniture</a>
            </nav>

            <div class="header-actions">
                <form class="header-search" action="/search" method="GET">
                    <label for="header-search-bar" class="hidden">Search artworks</label>
                    <input
                        id="header-search-bar"
                        type="search"
                        name="q"
                        value="<%= typeof search_query !== 'undefined' ? search_query : '' %>"
                        placeholder="Search artworks..."
                    />
                    <button type="submit" aria-label="Submit search">
                        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                    </button>
                </form>

                <a href="/cart" class="bag-trigger" aria-label="Shopping Bag">
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                    </svg>
                    <span>Bag</span>
                    <span class="bag-badge cart-count"><%= cart_count %></span>
                </a>
            </div>
        </div>

        <div class="mobile-drawer" id="mobileDrawer">
            <div class="mobile-drawer-links">
                <a href="/">Shop All</a>
                <a href="/?category=Painting">Paintings</a>
                <a href="/?category=Photography">Photography</a>
                <a href="/?category=Sculpture">Sculpture</a>
                <a href="/?category=Furniture">Furniture</a>
                <a href="/cart">Shopping Bag (<span class="cart-count"><%= cart_count %></span>)</a>
            </div>
        </div>
    </header>

    <main class="main-wrap">
        <!-- Archive Hero Header -->
        <section class="archive-hero">
            <div>
                <span class="hero-kicker">
                    <%= (typeof search_query !== 'undefined' && search_query) ? 'Archive Search Results' : 'Curated Gallery Archive' %>
                </span>
                <h1 class="archive-title">
                    <%= (typeof search_query !== 'undefined' && search_query) ? `Results for "${search_query}"` : 'The Complete Archive' %>
                </h1>
                <p class="archive-lead">
                    Original paintings, museum-grade photography, and sculptural lighting works sourced directly from independent contemporary studios and prepared for worldwide dispatch.
                </p>
                <div class="archive-meta">
                    <span>Showing <span class="mono-count" id="visibleCount"><%= products.length %></span> Works</span>
                    <span aria-hidden="true">·</span>
                    <span class="stock-note">Authenticated Originals · Insured Courier Dispatch</span>
                </div>
            </div>

            <div class="hero-visual">
                <img src="/static/images/8125999-IVGGQOPI-7.jpg" alt="ART STUDIO Curated Fine Art Collection" referrerPolicy="no-referrer" />
            </div>
        </section>

        <!-- Discipline & Artist Filter Bar -->
        <%
            const sourceList = (typeof all_products !== 'undefined' && all_products.length) ? all_products : products;
            const artistNames = Array.from(new Set(sourceList.map((p) => p.artist)));
            const disciplines = [
                { key: 'All', label: 'All Disciplines' },
                { key: 'Painting', label: 'Paintings' },
                { key: 'Photography', label: 'Photography' },
                { key: 'Sculpture', label: 'Sculpture' },
                { key: 'Furniture', label: 'Furniture' }
            ];
        %>
        <section class="filter-toolbar" aria-label="Archive filters">
            <div class="filter-row">
                <span class="filter-label">Discipline:</span>
                <% disciplines.forEach((d) => { %>
                    <button
                        type="button"
                        class="disc-btn <%= active_category.toLowerCase() === d.key.toLowerCase() ? 'active' : '' %>"
                        data-filter-category="<%= d.key %>"
                    ><%= d.label %></button>
                <% }) %>
            </div>

            <div class="filter-row-between">
                <div class="artist-row">
                    <span class="filter-label">Artist:</span>
                    <button
                        type="button"
                        class="artist-btn <%= active_artist === 'All' ? 'active' : '' %>"
                        data-filter-artist="All"
                    >All Artists</button>
                    <% artistNames.forEach((artistName) => { %>
                        <button
                            type="button"
                            class="artist-btn <%= active_artist.toLowerCase() === artistName.toLowerCase() ? 'active' : '' %>"
                            data-filter-artist="<%= artistName %>"
                        ><%= artistName %></button>
                    <% }) %>
                </div>

                <div class="sort-wrap">
                    <label for="sortSelect" class="filter-label" style="margin-right: 0;">Sort:</label>
                    <select id="sortSelect" class="sort-select">
                        <option value="featured">Featured</option>
                        <option value="price-asc">Price: Low to High</option>
                        <option value="price-desc">Price: High to Low</option>
                    </select>
                </div>
            </div>
        </section>

        <!-- Product Grid -->
        <% if (products && products.length) { %>
        <section id="gallery">
            <div class="product-grid" id="productGrid">
                <% products.forEach((item, index) => { %>
                <article
                    class="art-card"
                    data-category="<%= item.category %>"
                    data-artist="<%= item.artist %>"
                    data-price="<%= item.price %>"
                    data-order="<%= index %>"
                >
                    <div class="art-thumb">
                        <a href="/product/<%= item.id %>" aria-label="View <%= item.title %>">
                            <img src="<%= item.image %>" alt="<%= item.title %> by <%= item.artist %>" loading="lazy" referrerPolicy="no-referrer" />
                        </a>
                        <span class="status-tag">Original</span>
                        <div class="quick-add-wrap">
                            <form action="/add-to-cart" method="POST">
                                <input type="hidden" name="product_id" value="<%= item.id %>" />
                                <input type="hidden" name="quantity" value="1" />
                                <button type="submit" class="quick-add-btn">
                                    <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                                    </svg>
                                    <span>Quick Add to Bag</span>
                                </button>
                            </form>
                        </div>
                    </div>

                    <div class="art-body">
                        <div>
                            <span class="art-artist"><%= item.artist %></span>
                            <h2 class="art-title">
                                <a href="/product/<%= item.id %>"><%= item.title %></a>
                            </h2>
                            <p class="art-dims"><%= item.category %> · <%= item.size %></p>
                        </div>
                        <div class="art-price-row">
                            <span class="art-price">$<%= formatCurrency(item.price) %></span>
                        </div>
                    </div>
                </article>
                <% }) %>
            </div>

            <div class="empty-state hidden" id="filterEmptyState">
                <h2>No works match this filter</h2>
                <p>Reset your category or artist selection to browse the complete collection.</p>
                <button type="button" class="reset-btn" id="resetFiltersBtn">Reset Filters</button>
            </div>
        </section>
        <% } else { %>
        <section class="empty-state">
            <h2>No artworks found</h2>
            <p>Try searching by another artwork title, artist name, or discipline.</p>
            <a href="/" class="reset-btn">View Complete Archive</a>
        </section>
        <% } %>
    </main>

    <!-- Editorial Dark Footer -->
    <footer class="footer">
        <div class="footer-inner">
            <div class="footer-newsletter">
                <div>
                    <span class="footer-kicker">Stay Connected</span>
                    <h3 class="footer-heading">Curated releases and new acquisitions.</h3>
                    <p class="footer-sub">Receive updates when original paintings, archival photographs, and studio sculptures enter the collection.</p>
                </div>
                <div>
                    <form class="newsletter-form" id="newsletterForm">
                        <input type="email" id="newsletterEmail" required placeholder="Enter your email" />
                        <button type="submit">Subscribe</button>
                    </form>
                    <p class="newsletter-msg hidden" id="newsletterMsg">Thank you — you are on the private collector list.</p>
                </div>
            </div>

            <div class="footer-cols">
                <div class="footer-col">
                    <h4>Collection</h4>
                    <ul>
                        <li><a href="/">All Works</a></li>
                        <li><a href="/?category=Painting">Paintings</a></li>
                        <li><a href="/?category=Photography">Photography</a></li>
                        <li><a href="/?category=Sculpture">Sculpture</a></li>
                        <li><a href="/?category=Furniture">Furniture</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>Client Care</h4>
                    <ul>
                        <li><a href="/cart">Shopping Bag</a></li>
                        <li><a href="/checkout">Crypto Checkout</a></li>
                        <li><a href="/?category=Painting">Custom Framing Notes</a></li>
                        <li><a href="/?category=Sculpture">Courier Crating Info</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>Art Studio</h4>
                    <ul>
                        <li><a href="/">Curated Vault Archive</a></li>
                        <li><a href="/">Authenticity Guarantee</a></li>
                        <li><a href="/">Insured Worldwide Dispatch</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>Crypto Checkout</h4>
                    <p style="color: #8c8c8c; line-height: 1.65; margin: 0;">
                        Settle directly on-chain via Bitcoin, Ethereum, or Solana with instant conversion at live market rates and zero card holds.
                    </p>
                    <div class="crypto-pills">
                        <span class="crypto-tag" style="color: #f7931a;">BITCOIN (BTC)</span>
                        <span class="crypto-tag" style="color: #627eea;">ETHEREUM (ETH)</span>
                        <span class="crypto-tag" style="color: #14f195;">SOLANA (SOL)</span>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <span>© 2026 ART STUDIO. All rights reserved.</span>
                <span>Curated Fine Art &amp; Direct On-Chain Acquisition</span>
            </div>
        </div>
    </footer>

    <script>
        const menuToggle = document.getElementById('menuToggle');
        const mobileDrawer = document.getElementById('mobileDrawer');
        if (menuToggle && mobileDrawer) {
            menuToggle.addEventListener('click', () => {
                mobileDrawer.classList.toggle('open');
            });
        }

        const grid = document.getElementById('productGrid');
        const cards = grid ? Array.from(grid.querySelectorAll('.art-card')) : [];
        const visibleCountEl = document.getElementById('visibleCount');
        const filterEmptyState = document.getElementById('filterEmptyState');
        const resetFiltersBtn = document.getElementById('resetFiltersBtn');
        const discBtns = document.querySelectorAll('[data-filter-category]');
        const artistBtns = document.querySelectorAll('[data-filter-artist]');
        const sortSelect = document.getElementById('sortSelect');

        let selectedCategory = '<%= active_category %>';
        let selectedArtist = '<%= active_artist %>';
        let selectedSort = 'featured';

        function applyArchiveFilters() {
            if (!grid) return;

            const sorted = [...cards].sort((a, b) => {
                if (selectedSort === 'price-asc') {
                    return Number(a.dataset.price) - Number(b.dataset.price);
                }
                if (selectedSort === 'price-desc') {
                    return Number(b.dataset.price) - Number(a.dataset.price);
                }
                return Number(a.dataset.order) - Number(b.dataset.order);
            });

            let visibleCount = 0;
            sorted.forEach((card) => {
                grid.appendChild(card);
                const cat = (card.dataset.category || '').toLowerCase();
                const artist = (card.dataset.artist || '').toLowerCase();
                const matchCat = selectedCategory.toLowerCase() === 'all' || cat === selectedCategory.toLowerCase();
                const matchArtist = selectedArtist.toLowerCase() === 'all' || artist === selectedArtist.toLowerCase();
                const show = matchCat && matchArtist;
                card.classList.toggle('hidden', !show);
                if (show) visibleCount += 1;
            });

            if (visibleCountEl) visibleCountEl.textContent = String(visibleCount);
            if (filterEmptyState) filterEmptyState.classList.toggle('hidden', visibleCount > 0);
        }

        discBtns.forEach((btn) => {
            btn.addEventListener('click', () => {
                selectedCategory = btn.dataset.filterCategory || 'All';
                discBtns.forEach((b) => b.classList.toggle('active', b === btn));
                applyArchiveFilters();
            });
        });

        artistBtns.forEach((btn) => {
            btn.addEventListener('click', () => {
                selectedArtist = btn.dataset.filterArtist || 'All';
                artistBtns.forEach((b) => b.classList.toggle('active', b === btn));
                applyArchiveFilters();
            });
        });

        if (sortSelect) {
            sortSelect.addEventListener('change', () => {
                selectedSort = sortSelect.value;
                applyArchiveFilters();
            });
        }

        if (resetFiltersBtn) {
            resetFiltersBtn.addEventListener('click', () => {
                selectedCategory = 'All';
                selectedArtist = 'All';
                selectedSort = 'featured';
                if (sortSelect) sortSelect.value = 'featured';
                discBtns.forEach((b) => b.classList.toggle('active', (b.dataset.filterCategory || '').toLowerCase() === 'all'));
                artistBtns.forEach((b) => b.classList.toggle('active', (b.dataset.filterArtist || '').toLowerCase() === 'all'));
                applyArchiveFilters();
            });
        }

        const newsletterForm = document.getElementById('newsletterForm');
        const newsletterMsg = document.getElementById('newsletterMsg');
        if (newsletterForm && newsletterMsg) {
            newsletterForm.addEventListener('submit', (e) => {
                e.preventDefault();
                newsletterMsg.classList.remove('hidden');
                const input = document.getElementById('newsletterEmail');
                if (input) input.value = '';
            });
        }
    </script>
    <script src="/static/js/cart-sync.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Curated original fine art paintings, photography, and sculptures at ART STUDIO.">
    <meta property="og:title" content="The Complete Archive | ART STUDIO">
    <meta property="og:description" content="Curated original fine art paintings, photography, and sculptures at ART STUDIO.">
    <title>The Complete Archive | ART STUDIO</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Playfair+Display:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --ink: #0a0a0a;
            --ink-soft: #404040;
            --muted: #666666;
            --border: #dcdcdc;
            --card-border: #e5e5e5;
            --surface: #ffffff;
            --canvas: #fafafa;
            --gold: #a3702b;
            --gold-bright: #d4af37;
            --green: #047857;
            --font-sans: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            --font-serif: "Playfair Display", Georgia, serif;
            --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
        }

        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }

        body {
            margin: 0;
            font-family: var(--font-sans);
            background: var(--surface);
            color: var(--ink);
            -webkit-font-smoothing: antialiased;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        a { color: inherit; text-decoration: none; }
        button { font: inherit; }
        img { max-width: 100%; display: block; }

        /* Top Announcement Bar */
        .topbar {
            background: #111111;
            color: #ffffff;
            text-align: center;
            padding: 9px 16px;
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }

        /* Sticky Navigation Header */
        .header {
            background: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(8px);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 40;
        }

        .header-inner {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 32px;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
        }

        .mobile-toggle {
            display: none;
            background: none;
            border: none;
            padding: 6px;
            margin-left: -6px;
            color: var(--ink);
            cursor: pointer;
        }

        .brand-mark {
            font-family: var(--font-serif);
            font-size: 26px;
            font-weight: 400;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--ink);
            white-space: nowrap;
            flex-shrink: 0;
        }

        .nav {
            display: flex;
            align-items: center;
            gap: 22px;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--ink-soft);
        }

        .nav a {
            white-space: nowrap;
            padding: 4px 0;
            transition: color 0.15s ease;
        }

        .nav a:hover,
        .nav a.active {
            color: var(--ink);
            text-decoration: underline;
            text-underline-offset: 6px;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-shrink: 0;
        }

        .header-search {
            display: flex;
            align-items: center;
            border: 1px solid #d4d4d4;
            background: #fafafa;
            padding: 6px 10px;
            border-radius: 2px;
            transition: border-color 0.15s ease;
        }

        .header-search:focus-within {
            border-color: var(--ink);
            background: #ffffff;
        }

        .header-search input {
            border: none;
            background: transparent;
            font-family: var(--font-sans);
            font-size: 12px;
            color: var(--ink);
            width: 170px;
            outline: none;
        }

        .header-search input::placeholder {
            color: #999999;
        }

        .header-search button {
            background: none;
            border: none;
            padding: 0 0 0 6px;
            color: #666666;
            cursor: pointer;
            display: flex;
            align-items: center;
        }

        .header-search button:hover {
            color: var(--ink);
        }

        .bag-trigger {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            font-size: 12px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--ink);
            border-radius: 2px;
            white-space: nowrap;
            transition: background-color 0.15s ease;
        }

        .bag-trigger:hover {
            background: #f5f5f5;
        }

        .bag-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 20px;
            height: 20px;
            border-radius: 9999px;
            background: #171717;
            color: #ffffff;
            font-family: var(--font-mono);
            font-size: 11px;
            font-weight: 600;
        }

        .mobile-drawer {
            display: none;
            border-top: 1px solid var(--card-border);
            background: #ffffff;
            padding: 16px 24px 20px;
        }

        .mobile-drawer.open {
            display: block;
        }

        .mobile-drawer-links {
            display: flex;
            flex-direction: column;
            gap: 12px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.14em;
        }

        /* Main Container */
        .main-wrap {
            max-width: 1280px;
            width: 100%;
            margin: 0 auto;
            padding: 44px 24px 72px;
            flex: 1;
        }

        /* Editorial Shop Archive Hero */
        .archive-hero {
            padding-bottom: 36px;
            margin-bottom: 32px;
            border-bottom: 1px solid var(--border);
            display: grid;
            grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
            gap: 32px;
            align-items: center;
        }

        .hero-kicker {
            display: block;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            color: var(--gold);
            margin-bottom: 8px;
        }

        .archive-title {
            font-family: var(--font-serif);
            font-size: clamp(2.25rem, 4.2vw, 3rem);
            font-weight: 400;
            line-height: 1.1;
            letter-spacing: -0.02em;
            color: var(--ink);
            margin: 0 0 12px;
            text-wrap: balance;
        }

        .archive-lead {
            font-size: 14px;
            line-height: 1.65;
            color: #525252;
            max-width: 560px;
            margin: 0;
        }

        .archive-meta {
            margin-top: 16px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px;
            font-size: 12px;
            color: #666666;
        }

        .archive-meta .mono-count {
            font-family: var(--font-mono);
            font-variant-numeric: tabular-nums;
            color: var(--ink);
            font-weight: 500;
        }

        .archive-meta .stock-note {
            color: var(--green);
            font-weight: 500;
        }

        .hero-visual {
            position: relative;
            aspect-ratio: 16 / 9;
            border: 1px solid #d4d4d4;
            border-radius: 2px;
            overflow: hidden;
            background: #f5f5f5;
        }

        .hero-visual img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Filter & Sort Toolbar (Northstar Discipline + House Style) */
        .filter-toolbar {
            padding-bottom: 24px;
            margin-bottom: 32px;
            border-bottom: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .filter-row {
            display: flex;
            align-items: center;
            gap: 8px;
            overflow-x: auto;
            padding-bottom: 2px;
        }

        .filter-row-between {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }

        .filter-label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #525252;
            margin-right: 4px;
            flex-shrink: 0;
        }

        .disc-btn {
            padding: 8px 14px;
            min-height: 36px;
            font-size: 11px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            border: none;
            border-radius: 2px;
            background: #e3e3e3;
            color: #404040;
            cursor: pointer;
            white-space: nowrap;
            flex-shrink: 0;
            transition: background-color 0.15s ease, color 0.15s ease;
        }

        .disc-btn:hover {
            background: #d8d8d8;
            color: var(--ink);
        }

        .disc-btn.active {
            background: #0a0a0a;
            color: #ffffff;
        }

        .artist-row {
            display: flex;
            align-items: center;
            gap: 4px;
            overflow-x: auto;
            flex: 1;
            min-width: 0;
        }

        .artist-btn {
            background: none;
            border: none;
            padding: 6px 10px;
            min-height: 32px;
            font-size: 12px;
            color: #666666;
            cursor: pointer;
            white-space: nowrap;
            flex-shrink: 0;
            transition: color 0.15s ease;
        }

        .artist-btn:hover {
            color: var(--ink);
        }

        .artist-btn.active {
            color: var(--ink);
            font-weight: 700;
            text-decoration: underline;
            text-underline-offset: 5px;
        }

        .sort-wrap {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }

        .sort-select {
            font-family: var(--font-sans);
            font-size: 12px;
            color: var(--ink);
            background: #ffffff;
            border: 1px solid #d4d4d4;
            border-radius: 2px;
            padding: 6px 10px;
            cursor: pointer;
        }

        /* 4-Column Archive Product Grid */
        .product-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 24px;
        }

        .art-card {
            display: flex;
            flex-direction: column;
            background: #ffffff;
            border: 1px solid var(--card-border);
            border-radius: 2px;
            overflow: hidden;
            transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
        }

        .art-card:hover {
            border-color: #999999;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.07);
            transform: translateY(-2px);
        }

        .art-thumb {
            position: relative;
            aspect-ratio: 4 / 5;
            width: 100%;
            background: #ffffff;
            overflow: hidden;
        }

        .art-thumb a {
            position: absolute;
            inset: 0;
            display: block;
        }

        .art-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .art-card:hover .art-thumb img {
            transform: scale(1.03);
        }

        .status-tag {
            position: absolute;
            top: 12px;
            left: 12px;
            z-index: 2;
            font-family: var(--font-mono);
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            background: rgba(255, 255, 255, 0.95);
            color: #262626;
            padding: 3px 8px;
            border: 1px solid #d4d4d4;
            border-radius: 2px;
            pointer-events: none;
        }

        .quick-add-wrap {
            position: absolute;
            left: 12px;
            right: 12px;
            bottom: 12px;
            z-index: 3;
            opacity: 0;
            pointer-events: none;
            transform: translateY(8px);
            transition: opacity 0.2s ease, transform 0.2s ease;
        }

        .art-card:hover .quick-add-wrap,
        .art-card:focus-within .quick-add-wrap {
            opacity: 1;
            pointer-events: auto;
            transform: translateY(0);
        }

        @media (hover: none), (max-width: 1024px) {
            .quick-add-wrap {
                opacity: 1;
                pointer-events: auto;
                transform: translateY(0);
            }
        }

        .quick-add-btn {
            width: 100%;
            background: rgba(10, 10, 10, 0.95);
            color: #ffffff;
            border: none;
            border-radius: 2px;
            padding: 11px 14px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background-color 0.15s ease;
        }

        .quick-add-btn:hover {
            background: #000000;
        }

        .art-body {
            padding: 16px;
            display: flex;
            flex-direction: column;
            flex: 1;
            justify-content: space-between;
            gap: 12px;
            background: #ffffff;
        }

        .art-artist {
            display: block;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.18em;
            color: #666666;
            margin-bottom: 4px;
        }

        .art-title {
            margin: 0;
            font-size: 14px;
            font-weight: 500;
            line-height: 1.35;
            color: var(--ink);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .art-dims {
            margin: 4px 0 0;
            font-size: 12px;
            color: #737373;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .art-price-row {
            padding-top: 10px;
            border-top: 1px solid #e2e2e2;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .art-price {
            font-family: var(--font-mono);
            font-variant-numeric: tabular-nums;
            font-size: 14px;
            font-weight: 600;
            color: var(--ink);
        }

        .empty-state {
            text-align: center;
            padding: 64px 24px;
            border: 1px solid var(--card-border);
            background: var(--canvas);
        }

        .empty-state h2 {
            font-family: var(--font-serif);
            font-weight: 400;
            font-size: 26px;
            margin: 0 0 10px;
        }

        .empty-state p {
            color: var(--muted);
            font-size: 14px;
            margin: 0 0 20px;
        }

        .reset-btn {
            display: inline-block;
            padding: 12px 22px;
            background: var(--ink);
            color: #ffffff;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            border: none;
            cursor: pointer;
        }

        /* Live Fine Art Showcase & History of Art in London */
        .london-showcase-band {
            background: #fafafa;
            border-top: 1px solid var(--border);
            padding: 72px 24px 80px;
        }

        .london-showcase-inner {
            max-width: 1280px;
            margin: 0 auto;
        }

        .london-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 28px;
        }

        .london-kicker {
            display: block;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.18em;
            color: var(--gold);
            margin-bottom: 8px;
        }

        .london-title {
            font-family: var(--font-serif);
            font-size: clamp(1.85rem, 3vw, 2.5rem);
            font-weight: 400;
            line-height: 1.15;
            letter-spacing: -0.015em;
            margin: 0;
            color: var(--ink);
            text-wrap: balance;
        }

        .london-controls {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .london-counter {
            font-family: var(--font-mono);
            font-variant-numeric: tabular-nums;
            font-size: 12px;
            font-weight: 500;
            color: var(--muted);
            padding-right: 8px;
            white-space: nowrap;
        }

        .london-ctrl-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            z-index: 4;
            width: 44px;
            height: 44px;
            padding: 0;
            background: rgba(17, 17, 17, 0.76);
            backdrop-filter: blur(6px);
            border: 1px solid rgba(255, 255, 255, 0.28);
            border-radius: 2px;
            color: #ffffff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s ease, background-color 0.15s ease, border-color 0.15s ease;
        }

        .london-ctrl-btn.prev { left: 18px; }
        .london-ctrl-btn.next { right: 18px; }

        .london-stage:hover .london-ctrl-btn,
        .london-stage:focus-within .london-ctrl-btn {
            opacity: 1;
            pointer-events: auto;
        }

        .london-ctrl-btn:hover,
        .london-ctrl-btn:focus-visible {
            background: rgba(10, 10, 10, 0.94);
            border-color: #ffffff;
            outline: none;
        }

        @media (hover: none), (max-width: 768px) {
            .london-ctrl-btn {
                opacity: 1;
                pointer-events: auto;
            }
            .london-ctrl-btn.prev { left: 10px; }
            .london-ctrl-btn.next { right: 10px; }
        }

        .london-stage {
            position: relative;
            width: 100%;
            aspect-ratio: 16 / 9;
            max-height: 600px;
            background: #141414;
            border: 1px solid var(--border);
            border-radius: 2px;
            overflow: hidden;
        }

        .london-slide {
            position: absolute;
            inset: 0;
            opacity: 0;
            transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1);
            pointer-events: none;
        }

        .london-slide.active {
            opacity: 1;
            pointer-events: auto;
            z-index: 1;
        }

        .london-slide img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .london-scrim {
            position: absolute;
            inset: 0;
            background: linear-gradient(
                to top,
                rgba(10, 10, 10, 0.86) 0%,
                rgba(10, 10, 10, 0.36) 42%,
                rgba(10, 10, 10, 0) 100%
            );
            pointer-events: none;
        }

        .london-caption {
            position: absolute;
            left: 28px;
            right: 28px;
            bottom: 24px;
            z-index: 2;
            color: #ffffff;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 20px;
        }

        .london-fig {
            display: block;
            font-family: var(--font-mono);
            font-size: 11px;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: #e5e5e5;
            margin-bottom: 6px;
        }

        .london-caption-title {
            font-family: var(--font-serif);
            font-size: clamp(1.2rem, 2.2vw, 1.65rem);
            font-weight: 400;
            margin: 0 0 4px;
            color: #ffffff;
        }

        .london-caption-sub {
            margin: 0;
            font-size: 13px;
            color: #d4d4d4;
            max-width: 64ch;
            line-height: 1.5;
        }

        .london-progress-track {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 3px;
            background: rgba(255, 255, 255, 0.22);
            z-index: 3;
        }

        .london-progress-bar {
            width: 100%;
            height: 100%;
            background: var(--gold-bright);
            transform-origin: left center;
            transform: scaleX(0);
        }

        .london-chapters {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 10px;
            margin-top: 14px;
        }

        .london-chapter-btn {
            text-align: left;
            padding: 14px 16px;
            background: #ffffff;
            border: 1px solid var(--card-border);
            border-radius: 2px;
            cursor: pointer;
            transition: border-color 0.15s ease, background-color 0.15s ease;
        }

        .london-chapter-btn:hover,
        .london-chapter-btn:focus-visible {
            border-color: #737373;
            outline: none;
        }

        .london-chapter-btn.active {
            border-color: var(--ink);
            background: #ffffff;
            box-shadow: inset 0 -2px 0 var(--ink);
        }

        .london-chapter-num {
            display: block;
            font-family: var(--font-mono);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.1em;
            color: var(--muted);
            margin-bottom: 4px;
        }

        .london-chapter-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: var(--ink);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .london-essay-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
            gap: 56px;
            margin-top: 52px;
            padding-top: 44px;
            border-top: 1px solid var(--border);
            align-items: start;
        }

        .london-essay-kicker {
            display: block;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.16em;
            color: var(--muted);
            margin-bottom: 10px;
        }

        .london-essay-heading {
            font-family: var(--font-serif);
            font-size: clamp(1.65rem, 2.5vw, 2.15rem);
            font-weight: 400;
            line-height: 1.2;
            margin: 0 0 22px;
            color: var(--ink);
            text-wrap: balance;
        }

        .london-essay-body {
            max-width: 68ch;
        }

        .london-essay-body p {
            margin: 0 0 18px;
            font-size: 15px;
            line-height: 1.78;
            color: #262626;
        }

        .london-essay-body p:last-child {
            margin-bottom: 0;
        }

        .london-dropcap::first-letter {
            font-family: var(--font-serif);
            font-size: 3.35rem;
            font-weight: 500;
            line-height: 0.85;
            float: left;
            padding-right: 12px;
            padding-top: 4px;
            color: var(--ink);
        }

        .london-timeline {
            background: #ffffff;
            border: 1px solid var(--card-border);
            border-radius: 2px;
            padding: 28px;
        }

        .london-timeline-title {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.16em;
            color: var(--ink);
            margin: 0 0 18px;
            padding-bottom: 14px;
            border-bottom: 1px solid var(--border);
        }

        .london-timeline-list {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .london-timeline-item {
            display: grid;
            grid-template-columns: 64px 1fr;
            gap: 14px;
            padding: 13px 0;
            border-bottom: 1px solid #ececec;
            align-items: baseline;
        }

        .london-timeline-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .london-year {
            font-family: var(--font-mono);
            font-variant-numeric: tabular-nums;
            font-size: 12px;
            font-weight: 600;
            color: var(--gold);
        }

        .london-milestone strong {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: var(--ink);
            margin-bottom: 3px;
        }

        .london-milestone span {
            display: block;
            font-size: 12px;
            line-height: 1.55;
            color: #525252;
        }

        @media (prefers-reduced-motion: reduce) {
            .london-slide {
                transition: none;
            }
        }

        /* Dark Editorial Footer (Matching Northstar) */
        .footer {
            background: #111111;
            color: #999999;
            border-top: 1px solid #262626;
            padding: 56px 0 48px;
            margin-top: auto;
        }

        .footer-inner {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
        }

        .footer-newsletter {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 32px;
            padding-bottom: 44px;
            border-bottom: 1px solid #262626;
            align-items: center;
        }

        .footer-kicker {
            display: block;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            color: var(--gold-bright);
        }

        .footer-heading {
            font-family: var(--font-serif);
            font-size: clamp(1.5rem, 2.5vw, 1.875rem);
            font-weight: 400;
            color: #ffffff;
            margin: 6px 0 0;
            letter-spacing: -0.01em;
        }

        .footer-sub {
            font-size: 12px;
            color: #8c8c8c;
            margin: 8px 0 0;
            max-width: 440px;
            line-height: 1.6;
        }

        .newsletter-form {
            display: flex;
            gap: 8px;
            max-width: 440px;
            width: 100%;
            margin-left: auto;
        }

        .newsletter-form input {
            flex: 1;
            background: #1a1a1a;
            border: 1px solid #333333;
            color: #ffffff;
            padding: 10px 14px;
            font-size: 12px;
            border-radius: 2px;
            outline: none;
        }

        .newsletter-form input:focus {
            border-color: #ffffff;
        }

        .newsletter-form button {
            padding: 10px 20px;
            background: #ffffff;
            color: #000000;
            border: none;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            border-radius: 2px;
            cursor: pointer;
            flex-shrink: 0;
        }

        .newsletter-form button:hover {
            background: #e5e5e5;
        }

        .newsletter-msg {
            font-size: 12px;
            color: #10b981;
            margin: 8px 0 0;
            text-align: right;
        }

        .footer-cols {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 32px;
            padding: 44px 0;
            border-bottom: 1px solid #262626;
            font-size: 12px;
        }

        .footer-col h4 {
            color: #ffffff;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            margin: 0 0 16px;
        }

        .footer-col ul {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .footer-col a:hover {
            color: #ffffff;
        }

        .crypto-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 14px;
            font-family: var(--font-mono);
            font-size: 10px;
            font-weight: 600;
        }

        .crypto-tag {
            background: #1a1a1a;
            border: 1px solid #333333;
            padding: 4px 10px;
            border-radius: 2px;
        }

        .footer-bottom {
            padding-top: 28px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 14px;
            font-size: 11px;
            color: #737373;
        }

        .footer-legal {
            display: flex;
            flex-wrap: wrap;
            gap: 18px;
        }

        .footer-legal a:hover {
            color: #ffffff;
        }

        .hidden { display: none !important; }

        @media (max-width: 1024px) {
            .nav, .header-search { display: none; }
            .mobile-toggle { display: inline-flex; }
            .archive-hero { grid-template-columns: 1fr; }
            .product-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
            .london-essay-grid { grid-template-columns: 1fr; gap: 32px; }
            .footer-newsletter { grid-template-columns: 1fr; }
            .newsletter-form { margin-left: 0; }
            .newsletter-msg { text-align: left; }
        }

        @media (max-width: 768px) {
            .product-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 14px;
            }
            .london-chapters { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .london-stage { aspect-ratio: 4 / 3; }
            .footer-cols { grid-template-columns: repeat(2, 1fr); }
        }

        @media (max-width: 520px) {
            .main-wrap { padding: 28px 16px 56px; }
            .london-showcase-band { padding: 48px 16px 56px; }
            .london-caption { left: 16px; right: 16px; bottom: 16px; }
            .header-inner { padding: 0 16px; }
            .brand-mark { font-size: 20px; }
            .footer-bottom { flex-direction: column; align-items: flex-start; }
        }
    </style>
</head>
<body data-cid="<%= cid %>">

    <%- include('partials/site-header') %>

    <main class="main-wrap">
        <!-- Archive Hero Header -->
        <section class="archive-hero">
            <div>
                <span class="hero-kicker">
                    <%= (typeof search_query !== 'undefined' && search_query) ? 'Archive Search Results' : 'Curated Gallery Archive' %>
                </span>
                <h1 class="archive-title">
                    <%= (typeof search_query !== 'undefined' && search_query) ? `Results for "${search_query}"` : 'The Complete Archive' %>
                </h1>
                <p class="archive-lead">
                    Curated fine art, collectible design, and vintage objects—spanning original paintings, rare prints, archival photography, historical sculptures, and antique or modernist furniture sourced from independent studios and vetted dealers for insured worldwide dispatch.
                </p>
                <div class="archive-meta">
                    <span>Showing <span class="mono-count" id="visibleCount"><%= products.length %></span> Works</span>
                    <span aria-hidden="true">·</span>
                    <span class="stock-note">Authenticated Originals · Insured Courier Dispatch</span>
                </div>
            </div>

            <div class="hero-visual">
                <img src="/static/images/8125999-IVGGQOPI-7.jpg" alt="ART STUDIO Curated Fine Art Collection" referrerPolicy="no-referrer" />
            </div>
        </section>

        <!-- Discipline & Artist Filter Bar -->
        <%
            const sourceList = (typeof all_products !== 'undefined' && all_products.length) ? all_products : products;
            const artistNames = Array.from(new Set(sourceList.map((p) => p.artist)));
            const disciplines = [
                { key: 'All', label: 'All Disciplines' },
                { key: 'Painting', label: 'Paintings' },
                { key: 'Prints', label: 'Prints' },
                { key: 'Photography', label: 'Photography' },
                { key: 'Sculpture', label: 'Sculpture' },
                { key: 'Furniture', label: 'Furniture' }
            ];
        %>
        <section class="filter-toolbar" aria-label="Archive filters">
            <div class="filter-row">
                <span class="filter-label">Discipline:</span>
                <% disciplines.forEach((d) => { %>
                    <button
                        type="button"
                        class="disc-btn <%= active_category.toLowerCase() === d.key.toLowerCase() ? 'active' : '' %>"
                        data-filter-category="<%= d.key %>"
                    ><%= d.label %></button>
                <% }) %>
            </div>

            <div class="filter-row-between">
                <div class="artist-row">
                    <span class="filter-label">Artist:</span>
                    <button
                        type="button"
                        class="artist-btn <%= active_artist === 'All' ? 'active' : '' %>"
                        data-filter-artist="All"
                    >All Artists</button>
                    <% artistNames.forEach((artistName) => { %>
                        <button
                            type="button"
                            class="artist-btn <%= active_artist.toLowerCase() === artistName.toLowerCase() ? 'active' : '' %>"
                            data-filter-artist="<%= artistName %>"
                        ><%= artistName %></button>
                    <% }) %>
                </div>

                <div class="sort-wrap">
                    <label for="sortSelect" class="filter-label" style="margin-right: 0;">Sort:</label>
                    <select id="sortSelect" class="sort-select">
                        <option value="featured">Featured</option>
                        <option value="price-asc">Price: Low to High</option>
                        <option value="price-desc">Price: High to Low</option>
                    </select>
                </div>
            </div>
        </section>

        <!-- Product Grid -->
        <% if (products && products.length) { %>
        <section id="gallery">
            <div class="product-grid" id="productGrid">
                <% products.forEach((item, index) => { %>
                <article
                    class="art-card"
                    data-category="<%= item.category %>"
                    data-artist="<%= item.artist %>"
                    data-price="<%= item.price %>"
                    data-order="<%= index %>"
                >
                    <div class="art-thumb">
                        <a href="/product/<%= item.id %>" aria-label="View <%= item.title %>">
                            <img src="<%= item.image %>" alt="<%= item.title %> by <%= item.artist %>" loading="lazy" referrerPolicy="no-referrer" />
                        </a>
                        <span class="status-tag"><%= item.status === 'sold' ? 'Acquired' : 'Original' %></span>
                        <% if (item.status !== 'sold') { %>
                        <div class="quick-add-wrap">
                            <form action="/add-to-cart" method="POST">
                                <input type="hidden" name="product_id" value="<%= item.id %>" />
                                <input type="hidden" name="quantity" value="1" />
                                <button type="submit" class="quick-add-btn">
                                    <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                                    </svg>
                                    <span>Quick Add to Bag</span>
                                </button>
                            </form>
                        </div>
                        <% } %>
                    </div>

                    <div class="art-body">
                        <div>
                            <span class="art-artist">
                                <a href="/artists/<%= getArtistSlug(item.artist) %>" style="text-decoration: none;" title="Read biography of <%= item.artist %>"><%= item.artist %></a>
                            </span>
                            <h2 class="art-title">
                                <a href="/product/<%= item.id %>"><%= item.title %></a>
                            </h2>
                            <p class="art-dims"><%= item.category %> · <%= item.size %></p>
                            <p style="font-family: var(--font-mono); font-size: 10.5px; color: #737373; margin: 4px 0 0; letter-spacing: 0.03em;"><%= item.inventory_id %></p>
                        </div>
                        <div class="art-price-row">
                            <span class="art-price">$<%= formatCurrency(item.price) %></span>
                        </div>
                    </div>
                </article>
                <% }) %>
            </div>

            <div class="empty-state hidden" id="filterEmptyState">
                <h2>No works match this filter</h2>
                <p>Reset your category or artist selection to browse the complete collection.</p>
                <button type="button" class="reset-btn" id="resetFiltersBtn">Reset Filters</button>
            </div>
        </section>
        <% } else { %>
        <section class="empty-state">
            <h2>No artworks found</h2>
            <p>Try searching by another artwork title, artist name, discipline, or Inventory ID (e.g. AS-PA-2026-001).</p>
            <a href="/" class="reset-btn">View Complete Archive</a>
        </section>
        <% } %>
    </main>

    <!-- Live Fine Art Showcase & History of Art in London -->
    <section class="london-showcase-band" id="london-exhibition" aria-labelledby="london-exhibition-title">
        <div class="london-showcase-inner">
            <div class="london-header">
                <div>
                    <span class="london-kicker">Live Fine Art Showcase</span>
                    <h2 class="london-title" id="london-exhibition-title">London Exhibitions &amp; Living Studios</h2>
                </div>
                <div class="london-controls">
                    <span class="london-counter" id="londonSlideCounter">01 / 04</span>
                </div>
            </div>

            <div class="london-stage" id="londonStage" role="region" aria-roledescription="carousel" aria-label="Live fine art exhibition rooms">
                <button type="button" class="london-ctrl-btn prev" id="londonPrevBtn" aria-label="Previous exhibition view">
                    <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 19l-7-7 7-7"/>
                    </svg>
                </button>
                <button type="button" class="london-ctrl-btn next" id="londonNextBtn" aria-label="Next exhibition view">
                    <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 5l7 7-7 7"/>
                    </svg>
                </button>

                <figure class="london-slide active" data-slide="0">
                    <img src="/static/images/london-gallery-1.jpg" alt="Trafalgar Square classical gallery hall with gilt-framed historic British portraits and maritime oils" referrerPolicy="no-referrer" />
                    <div class="london-scrim" aria-hidden="true"></div>
                    <figcaption class="london-caption">
                        <div>
                            <span class="london-fig">Fig. 01 · Trafalgar Square Archive</span>
                            <h3 class="london-caption-title">Georgian Portraiture &amp; The National Collection</h3>
                            <p class="london-caption-sub">From Joshua Reynolds's Royal Academy lectures to Trafalgar Square's grand rooms, London established public access to Old Master and British painting.</p>
                        </div>
                    </figcaption>
                </figure>

                <figure class="london-slide" data-slide="1">
                    <img src="/static/images/london-gallery-2.jpg" alt="19th-century Romantic British landscape gallery room depicting golden light over the River Thames and Westminster" referrerPolicy="no-referrer" />
                    <div class="london-scrim" aria-hidden="true"></div>
                    <figcaption class="london-caption">
                        <div>
                            <span class="london-fig">Fig. 02 · Millbank &amp; Westminster</span>
                            <h3 class="london-caption-title">Thames Luminosity &amp; Romantic Light</h3>
                            <p class="london-caption-sub">J.M.W. Turner and John Constable transformed 19th-century landscape painting along London's docks, bridges, and shifting river mist.</p>
                        </div>
                    </figcaption>
                </figure>

                <figure class="london-slide" data-slide="2">
                    <img src="/static/images/london-gallery-3.jpg" alt="Early 20th-century Bloomsbury and Fitzrovia London artist studio with north-facing sash windows and modernist canvases" referrerPolicy="no-referrer" />
                    <div class="london-scrim" aria-hidden="true"></div>
                    <figcaption class="london-caption">
                        <div>
                            <span class="london-fig">Fig. 03 · Bloomsbury &amp; Fitzrovia</span>
                            <h3 class="london-caption-title">Modernist Ateliers &amp; The School of London</h3>
                            <p class="london-caption-sub">From Fitzroy Square's Omega Workshops to postwar Soho studios, London ateliers reshaped European abstraction and visceral figuration.</p>
                        </div>
                    </figcaption>
                </figure>

                <figure class="london-slide" data-slide="3">
                    <img src="/static/images/london-gallery-4.jpg" alt="Contemporary Mayfair and East London gallery space exhibiting impasto oil paintings and bronze sculpture" referrerPolicy="no-referrer" />
                    <div class="london-scrim" aria-hidden="true"></div>
                    <figcaption class="london-caption">
                        <div>
                            <span class="london-fig">Fig. 04 · Mayfair &amp; Shoreditch</span>
                            <h3 class="london-caption-title">Contemporary London &amp; Independent Studios</h3>
                            <p class="london-caption-sub">Today's galleries from Cork Street to Hackney Wick bridge historic craft with bold contemporary painting, ceramics, and sculpture.</p>
                        </div>
                    </figcaption>
                </figure>

                <div class="london-progress-track" aria-hidden="true">
                    <div class="london-progress-bar" id="londonProgressBar"></div>
                </div>
            </div>

            <div class="london-chapters" role="tablist" aria-label="London art eras">
                <button type="button" class="london-chapter-btn active" data-goto-slide="0" role="tab" aria-selected="true">
                    <span class="london-chapter-num">01 / 1768–1824</span>
                    <span class="london-chapter-label">Trafalgar Square</span>
                </button>
                <button type="button" class="london-chapter-btn" data-goto-slide="1" role="tab" aria-selected="false">
                    <span class="london-chapter-num">02 / 1825–1897</span>
                    <span class="london-chapter-label">Thames Romanticism</span>
                </button>
                <button type="button" class="london-chapter-btn" data-goto-slide="2" role="tab" aria-selected="false">
                    <span class="london-chapter-num">03 / 1905–1975</span>
                    <span class="london-chapter-label">Bloomsbury &amp; Soho</span>
                </button>
                <button type="button" class="london-chapter-btn" data-goto-slide="3" role="tab" aria-selected="false">
                    <span class="london-chapter-num">04 / 1988–Present</span>
                    <span class="london-chapter-label">Contemporary London</span>
                </button>
            </div>

            <div class="london-essay-grid">
                <article class="london-essay-body">
                    <span class="london-essay-kicker">Curatorial Essay · London Art Chronicle</span>
                    <h3 class="london-essay-heading">The History of Art in London</h3>

                    <p class="london-dropcap">
                        London's emergence as an international center of fine art began in royal workshops and guild halls along the Thames. During the sixteenth century, Hans Holbein the Younger elevated Tudor court portraiture at Whitehall, while in the eighteenth century William Hogarth turned Covent Garden's coffeehouses and streets into vivid narratives of modern civic life.
                    </p>
                    <p>
                        In 1768, the founding of the Royal Academy of Arts under Sir Joshua Reynolds gave British painters, sculptors, and architects formal institutional stature. That momentum culminated in 1824 with the opening of the National Gallery at Trafalgar Square, placing European and British masterworks on public view for every citizen rather than confining them to private estates.
                    </p>
                    <p>
                        Across the nineteenth century, J.M.W. Turner and John Constable dissolved rigid academic conventions in favor of atmospheric light, steam, and river mist, paving the way for the Pre-Raphaelite Brotherhood in Bloomsbury and Chelsea. By the early twentieth century, Roger Fry and Vanessa Bell's Omega Workshops introduced Post-Impressionism and bold studio craft to Fitzrovia, before postwar masters including Francis Bacon and Lucian Freud forged the visceral School of London inside Soho's cramped upstairs rooms.
                    </p>
                    <p>
                        With the transformation of Bankside Power Station into Tate Modern in 2000 and the flourishing of independent studios across Shoreditch, Hackney, and Mayfair, London remains one of the world's most vital crossroads—uniting centuries of museum provenance with living artists working directly for global collectors.
                    </p>
                </article>

                <aside class="london-timeline" aria-label="Chronology of Art in London">
                    <h4 class="london-timeline-title">Milestones in London Art</h4>
                    <ol class="london-timeline-list">
                        <li class="london-timeline-item">
                            <span class="london-year">1768</span>
                            <div class="london-milestone">
                                <strong>Royal Academy of Arts</strong>
                                <span>Founded by Sir Joshua Reynolds and George III to champion British painting, sculpture, and architecture.</span>
                            </div>
                        </li>
                        <li class="london-timeline-item">
                            <span class="london-year">1824</span>
                            <div class="london-milestone">
                                <strong>The National Gallery</strong>
                                <span>Established on Trafalgar Square, opening the national collection of European paintings free to the public.</span>
                            </div>
                        </li>
                        <li class="london-timeline-item">
                            <span class="london-year">1897</span>
                            <div class="london-milestone">
                                <strong>Tate Britain (Millbank)</strong>
                                <span>Opened as the National Gallery of British Art, anchored by Turner's sweeping bequest to the nation.</span>
                            </div>
                        </li>
                        <li class="london-timeline-item">
                            <span class="london-year">1913</span>
                            <div class="london-milestone">
                                <strong>Bloomsbury &amp; Omega Workshops</strong>
                                <span>Vanessa Bell, Duncan Grant, and Roger Fry bridge modernist painting with decorative studio objects in Fitzrovia.</span>
                            </div>
                        </li>
                        <li class="london-timeline-item">
                            <span class="london-year">2000</span>
                            <div class="london-milestone">
                                <strong>Tate Modern &amp; East End Studios</strong>
                                <span>Bankside opens on the Thames alongside thriving contemporary galleries across Mayfair and East London.</span>
                            </div>
                        </li>
                    </ol>
                </aside>
            </div>
        </div>
    </section>

    <!-- Editorial Dark Footer -->
    <footer class="footer">
        <div class="footer-inner">
            <div class="footer-newsletter">
                <div>
                    <span class="footer-kicker">Stay Connected</span>
                    <h3 class="footer-heading">Curated releases and new acquisitions.</h3>
                    <p class="footer-sub">Receive updates when original paintings, rare prints, archival photography, historical sculptures, and collectible vintage furniture enter the archive.</p>
                </div>
                <div>
                    <form class="newsletter-form" id="newsletterForm">
                        <input type="email" id="newsletterEmail" required placeholder="Enter your email" />
                        <button type="submit">Subscribe</button>
                    </form>
                    <p class="newsletter-msg hidden" id="newsletterMsg" role="status" aria-live="polite">Thank you — you are on the private collector list.</p>
                </div>
            </div>

            <div class="footer-cols">
                <div class="footer-col">
                    <h4>Collection</h4>
                    <ul>
                        <% (primaryNavLinks || []).filter((n) => n.key !== 'Artists').forEach((navItem) => { %>
                            <li><a href="<%= navItem.href %>"><%= navItem.label %></a></li>
                        <% }) %>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>Client Care</h4>
                    <ul>
                        <li><a href="/shipping">Shipping &amp; Delivery</a></li>
                        <li><a href="/contact">Contact &amp; Support</a></li>
                        <li><a href="/cart">Shopping Bag</a></li>
                        <li><a href="/crypto-checkout">Crypto Checkout</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>Art Studio &amp; Trust</h4>
                    <ul>
                        <li><a href="/artists">Meet the Artists</a></li>
                        <li><a href="/authenticity">Artwork Authenticity</a></li>
                        <li><a href="/terms">Terms &amp; Conditions</a></li>
                        <li><a href="/privacy-policy">Privacy Policy</a></li>
                        <li><a href="/admin/inventory">Inventory Registry (Admin)</a></li>
                        <li><a href="/">Curated Vault Archive</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>Crypto Checkout</h4>
                    <p style="color: #8c8c8c; line-height: 1.65; margin: 0;">
                        Settle directly on-chain via Bitcoin, Ethereum, or Solana with instant conversion at live market rates and zero card holds.
                    </p>
                    <div class="crypto-pills">
                        <span class="crypto-tag" style="color: #f7931a;">BITCOIN (BTC)</span>
                        <span class="crypto-tag" style="color: #627eea;">ETHEREUM (ETH)</span>
                        <span class="crypto-tag" style="color: #14f195;">SOLANA (SOL)</span>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <span>© 2026 ART STUDIO. All rights reserved.</span>
                <nav class="footer-legal" aria-label="Footer policies">
                    <a href="/shipping">Shipping &amp; Delivery</a>
                    <a href="/authenticity">Artwork Authenticity</a>
                    <a href="/terms">Terms &amp; Conditions</a>
                    <a href="/privacy-policy">Privacy Policy</a>
                    <a href="/contact">Contact &amp; Support</a>
                </nav>
            </div>
        </div>
    </footer>

    <script>
        const grid = document.getElementById('productGrid');
        const cards = grid ? Array.from(grid.querySelectorAll('.art-card')) : [];
        const visibleCountEl = document.getElementById('visibleCount');
        const filterEmptyState = document.getElementById('filterEmptyState');
        const resetFiltersBtn = document.getElementById('resetFiltersBtn');
        const discBtns = document.querySelectorAll('[data-filter-category]');
        const artistBtns = document.querySelectorAll('[data-filter-artist]');
        const sortSelect = document.getElementById('sortSelect');

        let selectedCategory = '<%= active_category %>';
        let selectedArtist = '<%= active_artist %>';
        let selectedSort = 'featured';

        function applyArchiveFilters() {
            if (!grid) return;

            const sorted = [...cards].sort((a, b) => {
                if (selectedSort === 'price-asc') {
                    return Number(a.dataset.price) - Number(b.dataset.price);
                }
                if (selectedSort === 'price-desc') {
                    return Number(b.dataset.price) - Number(a.dataset.price);
                }
                return Number(a.dataset.order) - Number(b.dataset.order);
            });

            let visibleCount = 0;
            sorted.forEach((card) => {
                grid.appendChild(card);
                const cat = (card.dataset.category || '').toLowerCase();
                const artist = (card.dataset.artist || '').toLowerCase();
                const matchCat = selectedCategory.toLowerCase() === 'all' || cat === selectedCategory.toLowerCase();
                const matchArtist = selectedArtist.toLowerCase() === 'all' || artist === selectedArtist.toLowerCase();
                const show = matchCat && matchArtist;
                card.classList.toggle('hidden', !show);
                if (show) visibleCount += 1;
            });

            if (visibleCountEl) visibleCountEl.textContent = String(visibleCount);
            if (filterEmptyState) filterEmptyState.classList.toggle('hidden', visibleCount > 0);
        }

        discBtns.forEach((btn) => {
            btn.addEventListener('click', () => {
                selectedCategory = btn.dataset.filterCategory || 'All';
                discBtns.forEach((b) => b.classList.toggle('active', b === btn));
                applyArchiveFilters();
            });
        });

        artistBtns.forEach((btn) => {
            btn.addEventListener('click', () => {
                selectedArtist = btn.dataset.filterArtist || 'All';
                artistBtns.forEach((b) => b.classList.toggle('active', b === btn));
                applyArchiveFilters();
            });
        });

        if (sortSelect) {
            sortSelect.addEventListener('change', () => {
                selectedSort = sortSelect.value;
                applyArchiveFilters();
            });
        }

        if (resetFiltersBtn) {
            resetFiltersBtn.addEventListener('click', () => {
                selectedCategory = 'All';
                selectedArtist = 'All';
                selectedSort = 'featured';
                if (sortSelect) sortSelect.value = 'featured';
                discBtns.forEach((b) => b.classList.toggle('active', (b.dataset.filterCategory || '').toLowerCase() === 'all'));
                artistBtns.forEach((b) => b.classList.toggle('active', (b.dataset.filterArtist || '').toLowerCase() === 'all'));
                applyArchiveFilters();
            });
        }

        const newsletterForm = document.getElementById('newsletterForm');
        const newsletterMsg = document.getElementById('newsletterMsg');
        if (newsletterForm && newsletterMsg) {
            newsletterForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const input = document.getElementById('newsletterEmail');
                const submitBtn = newsletterForm.querySelector('button[type="submit"]');
                const email = input ? input.value.trim() : '';
                if (!email) return;

                if (submitBtn) submitBtn.disabled = true;
                try {
                    const res = await fetch('/api/newsletter', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ email })
                    });
                    const data = await res.json();
                    newsletterMsg.textContent = data.message || 'Thank you — you are on the private collector list.';
                    newsletterMsg.style.color = data.ok ? '#34d399' : '#fca5a5';
                    newsletterMsg.classList.remove('hidden');
                    if (data.ok && input) input.value = '';
                } catch {
                    newsletterMsg.textContent = 'Unable to register right now. Please try again shortly.';
                    newsletterMsg.style.color = '#fca5a5';
                    newsletterMsg.classList.remove('hidden');
                } finally {
                    if (submitBtn) submitBtn.disabled = false;
                }
            });
        }

        (() => {
            const slides = Array.from(document.querySelectorAll('.london-slide'));
            const chapterBtns = Array.from(document.querySelectorAll('.london-chapter-btn'));
            const counterEl = document.getElementById('londonSlideCounter');
            const prevBtn = document.getElementById('londonPrevBtn');
            const nextBtn = document.getElementById('londonNextBtn');
            const progressBar = document.getElementById('londonProgressBar');
            const stage = document.getElementById('londonStage');
            if (!slides.length) return;

            const INTERVAL_MS = 5000;
            const reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            let activeSlide = 0;
            let isPaused = false;
            let elapsedBeforePause = 0;
            let cycleStart = performance.now();
            let rafId = null;

            function renderSlide(idx) {
                activeSlide = (idx + slides.length) % slides.length;
                slides.forEach((s, i) => s.classList.toggle('active', i === activeSlide));
                chapterBtns.forEach((b, i) => {
                    const active = i === activeSlide;
                    b.classList.toggle('active', active);
                    b.setAttribute('aria-selected', active ? 'true' : 'false');
                });
                if (counterEl) {
                    counterEl.textContent = `${String(activeSlide + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
                }
                elapsedBeforePause = 0;
                cycleStart = performance.now();
                if (progressBar) {
                    progressBar.style.transform = 'scaleX(0)';
                }
            }

            function tick(now) {
                if (!isPaused && !reducedMotion) {
                    const elapsed = elapsedBeforePause + (now - cycleStart);
                    const pct = Math.min(1, elapsed / INTERVAL_MS);
                    if (progressBar) {
                        progressBar.style.transform = `scaleX(${pct.toFixed(4)})`;
                    }
                    if (elapsed >= INTERVAL_MS) {
                        renderSlide(activeSlide + 1);
                    }
                }
                rafId = requestAnimationFrame(tick);
            }

            if (prevBtn) prevBtn.addEventListener('click', () => renderSlide(activeSlide - 1));
            if (nextBtn) nextBtn.addEventListener('click', () => renderSlide(activeSlide + 1));
            chapterBtns.forEach((btn) => {
                btn.addEventListener('click', () => {
                    const target = Number(btn.dataset.gotoSlide || 0);
                    renderSlide(target);
                });
            });

            if (stage) {
                stage.addEventListener('mouseenter', () => {
                    if (!isPaused) elapsedBeforePause += performance.now() - cycleStart;
                    isPaused = true;
                });
                stage.addEventListener('mouseleave', () => {
                    cycleStart = performance.now();
                    isPaused = false;
                });
            }

            renderSlide(0);
            if (!reducedMotion) {
                rafId = requestAnimationFrame(tick);
            }
            window.addEventListener('beforeunload', () => {
                if (rafId !== null) cancelAnimationFrame(rafId);
            });
        })();
    </script>
    <script src="/static/js/cart-sync.js"></script>
</body>
</html>

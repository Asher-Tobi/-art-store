<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Curatorial Admin Sign In | ART STUDIO</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Playfair+Display:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --canvas: #f8f7f4;
            --surface: #ffffff;
            --ink: #0a0a0a;
            --muted: #525252;
            --border: #dcdad3;
            --gold: #8a6d3b;
            --red: #991b1b;
            --font-serif: "Playfair Display", Georgia, serif;
            --font-sans: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: var(--font-sans);
            background: var(--canvas);
            color: var(--ink);
            -webkit-font-smoothing: antialiased;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        a { color: inherit; text-decoration: none; }

        .auth-stage {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px 20px 72px;
        }

        .auth-card {
            width: 100%;
            max-width: 460px;
            background: var(--surface);
            border: 1px solid var(--border);
            padding: 40px 36px;
        }

        .auth-kicker {
            display: block;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            color: var(--gold);
            margin-bottom: 10px;
        }

        .auth-title {
            font-family: var(--font-serif);
            font-size: 28px;
            font-weight: 400;
            margin: 0 0 10px;
            letter-spacing: -0.02em;
            line-height: 1.15;
        }

        .auth-lead {
            margin: 0 0 24px;
            font-size: 13.5px;
            line-height: 1.65;
            color: var(--muted);
        }

        .auth-alert {
            margin: 0 0 20px;
            padding: 12px 14px;
            border: 1px solid #fecaca;
            background: #fef2f2;
            color: var(--red);
            font-size: 13px;
            line-height: 1.5;
            border-radius: 2px;
        }

        .auth-info {
            margin: 0 0 20px;
            padding: 12px 14px;
            border: 1px solid #e7e2d5;
            background: #fcfaf5;
            color: #44403c;
            font-size: 12.5px;
            line-height: 1.55;
            border-radius: 2px;
        }

        .auth-field {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 16px;
        }

        .auth-field label {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            color: #404040;
        }

        .auth-field input {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #cccccc;
            background: #fafafa;
            font-family: var(--font-sans);
            font-size: 14px;
            color: var(--ink);
            border-radius: 2px;
        }

        .auth-field input:focus {
            outline: none;
            border-color: var(--ink);
            background: #ffffff;
        }

        .auth-submit {
            width: 100%;
            padding: 13px 18px;
            background: var(--ink);
            color: #ffffff;
            border: 1px solid var(--ink);
            border-radius: 2px;
            font-family: var(--font-sans);
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            cursor: pointer;
            margin-top: 4px;
        }

        .auth-submit:hover {
            background: #262626;
        }

        .auth-foot {
            margin-top: 22px;
            padding-top: 18px;
            border-top: 1px solid #eceae2;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            font-size: 12px;
            color: var(--muted);
        }

        .auth-foot a:hover {
            color: var(--ink);
            text-decoration: underline;
            text-underline-offset: 4px;
        }

        .footer {
            background: #111111;
            color: #999999;
            border-top: 1px solid #262626;
            padding: 30px 24px;
            margin-top: auto;
        }

        .footer-inner {
            max-width: 1280px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            font-size: 12px;
        }

        @media (max-width: 560px) {
            .auth-card {
                padding: 28px 22px;
            }
        }
    </style>
</head>
<body data-cid="<%= cid %>">
    <%- include('partials/site-header', { topbarText: 'ART STUDIO · Restricted Curatorial Registry Access' }) %>

    <main class="auth-stage">
        <section class="auth-card" aria-labelledby="adminAuthTitle">
            <span class="auth-kicker">Curatorial Administration</span>
            <h1 class="auth-title" id="adminAuthTitle">Inventory Registry Sign In</h1>
            <p class="auth-lead">
                Private curatorial access only. Enter your unique administrator passcode to manage inventory records, authenticity statuses, and collector orders.
            </p>

            <% if (errorMessage) { %>
                <div class="auth-alert" role="alert"><%= errorMessage %></div>
            <% } %>

            <% if (messages && messages.length) { %>
                <% messages.forEach((msg) => { %>
                    <div class="auth-info" role="status"><%= msg %></div>
                <% }) %>
            <% } %>

            <form action="/admin/login" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <div class="auth-field">
                    <label for="adminPasscode">Administrator Passcode</label>
                    <input id="adminPasscode" type="password" name="passcode" autocomplete="current-password" required autofocus />
                </div>
                <button type="submit" class="auth-submit">Authenticate &amp; Open Registry</button>
            </form>

            <div class="auth-foot">
                <a href="/">← Return to Storefront</a>
                <a href="/authenticity">Authenticity Policy</a>
            </div>
        </section>
    </main>

    <footer class="footer">
        <div class="footer-inner">
            <span>© 2026 ART STUDIO. All rights reserved.</span>
            <span>Restricted Curatorial Access</span>
        </div>
    </footer>
    <script src="/static/js/cart-sync.js"></script>
</body>
</html>

<style>
    .site-topbar {
        background: #111111;
        color: #ffffff;
        text-align: center;
        padding: 9px 16px;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        font-family: var(--font-sans, "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
    }

    .site-header {
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--border, #dcdcdc);
        position: sticky;
        top: 0;
        z-index: 40;
    }

    .site-header-inner {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 24px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .site-header-left {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-shrink: 0;
    }

    .site-mobile-toggle {
        display: none;
        background: none;
        border: none;
        padding: 6px;
        margin-left: -6px;
        color: var(--ink, #0a0a0a);
        cursor: pointer;
        align-items: center;
        justify-content: center;
    }

    .site-brand-mark {
        font-family: var(--font-serif, "Playfair Display", Georgia, serif);
        font-size: 24px;
        font-weight: 400;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--ink, #0a0a0a);
        white-space: nowrap;
        flex-shrink: 0;
        text-decoration: none;
    }

    .site-nav {
        display: flex;
        align-items: center;
        gap: 18px;
        font-family: var(--font-sans, "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
        font-size: 11.5px;
        font-weight: 600;
        letter-spacing: 0.11em;
        text-transform: uppercase;
        color: #404040;
    }

    .site-nav a {
        white-space: nowrap;
        padding: 4px 0;
        color: inherit;
        text-decoration: none;
        transition: color 0.15s ease;
    }

    .site-nav a:hover,
    .site-nav a.active {
        color: var(--ink, #0a0a0a);
        text-decoration: underline;
        text-underline-offset: 6px;
    }

    .site-header-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-shrink: 0;
    }

    .site-search {
        display: flex;
        align-items: center;
        border: 1px solid #d4d4d4;
        background: #fafafa;
        padding: 5px 9px;
        border-radius: 2px;
        transition: border-color 0.15s ease, background-color 0.15s ease;
    }

    .site-search:focus-within {
        border-color: var(--ink, #0a0a0a);
        background: #ffffff;
    }

    .site-search input {
        border: none;
        background: transparent;
        font-family: var(--font-sans, "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
        font-size: 12px;
        color: var(--ink, #0a0a0a);
        width: 126px;
        outline: none;
        transition: width 0.2s ease;
    }

    .site-search input:focus {
        width: 156px;
    }

    .site-search input::placeholder {
        color: #8c8c8c;
    }

    .site-search button {
        background: none;
        border: none;
        padding: 0 0 0 6px;
        color: #666666;
        cursor: pointer;
        display: flex;
        align-items: center;
    }

    .site-search button:hover {
        color: var(--ink, #0a0a0a);
    }

    .site-bag-trigger {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 10px;
        font-size: 11.5px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--ink, #0a0a0a);
        border-radius: 2px;
        white-space: nowrap;
        text-decoration: none;
        transition: background-color 0.15s ease;
    }

    .site-bag-trigger:hover {
        background: #f5f5f5;
    }

    .site-bag-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        border-radius: 9999px;
        background: #171717;
        color: #ffffff;
        font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
        font-size: 11px;
        font-weight: 600;
    }

    .site-mobile-drawer {
        display: none;
        border-top: 1px solid #e5e5e5;
        background: #ffffff;
        padding: 18px 24px 22px;
    }

    .site-mobile-drawer.open {
        display: block;
    }

    .site-mobile-search {
        display: flex;
        align-items: center;
        border: 1px solid #d4d4d4;
        background: #fafafa;
        padding: 8px 12px;
        border-radius: 2px;
        margin-bottom: 16px;
    }

    .site-mobile-search input {
        flex: 1;
        border: none;
        background: transparent;
        font-size: 13px;
        color: var(--ink, #0a0a0a);
        outline: none;
    }

    .site-mobile-search button {
        background: none;
        border: none;
        color: #525252;
        cursor: pointer;
        padding: 0 0 0 8px;
        display: flex;
        align-items: center;
    }

    .site-mobile-links {
        display: flex;
        flex-direction: column;
        gap: 12px;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: #262626;
    }

    .site-mobile-links a {
        text-decoration: none;
        color: inherit;
        padding: 2px 0;
    }

    .site-mobile-links a.active {
        color: #0a0a0a;
        text-decoration: underline;
        text-underline-offset: 5px;
    }

    .site-mobile-divider {
        height: 1px;
        background: #ececec;
        margin: 4px 0;
    }

    .site-sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        border: 0;
    }

    @media (max-width: 1120px) {
        .site-nav,
        .site-search {
            display: none;
        }
        .site-mobile-toggle {
            display: inline-flex;
        }
    }

    @media (max-width: 520px) {
        .site-header-inner {
            padding: 0 16px;
        }
        .site-brand-mark {
            font-size: 19px;
            letter-spacing: 0.14em;
        }
    }
</style>

<div class="site-topbar"><%= (typeof topbarText !== 'undefined' && topbarText) ? topbarText : 'Insured Fine Art Courier Delivery · Pay Direct with BTC, ETH, or SOL' %></div>

<header class="site-header">
    <div class="site-header-inner">
        <div class="site-header-left">
            <button type="button" class="site-mobile-toggle" id="siteMenuToggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="siteMobileDrawer">
                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
            </button>
            <a href="/" class="site-brand-mark">ART STUDIO</a>
        </div>

        <nav class="site-nav" aria-label="Primary navigation">
            <% (primaryNavLinks || []).forEach((navItem) => { %>
                <a
                    href="<%= navItem.href %>"
                    class="<%= (typeof activeNav !== 'undefined' && activeNav && activeNav.toLowerCase() === navItem.key.toLowerCase()) ? 'active' : '' %>"
                ><%= navItem.label %></a>
            <% }) %>
        </nav>

        <div class="site-header-actions">
            <form class="site-search" action="/search" method="GET" role="search">
                <label for="site-header-search" class="site-sr-only">Search artworks</label>
                <input
                    id="site-header-search"
                    type="search"
                    name="q"
                    value="<%= typeof search_query !== 'undefined' ? search_query : '' %>"
                    placeholder="Search art or ID..."
                />
                <button type="submit" aria-label="Submit search">
                    <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                </button>
            </form>

            <a href="/cart" class="site-bag-trigger" aria-label="Shopping Bag">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                </svg>
                <span>Bag</span>
                <span class="site-bag-badge cart-count"><%= cart_count %></span>
            </a>
        </div>
    </div>

    <div class="site-mobile-drawer" id="siteMobileDrawer">
        <form class="site-mobile-search" action="/search" method="GET" role="search">
            <label for="site-mobile-search-input" class="site-sr-only">Search artworks</label>
            <input
                id="site-mobile-search-input"
                type="search"
                name="q"
                value="<%= typeof search_query !== 'undefined' ? search_query : '' %>"
                placeholder="Search artworks, artists, or Inventory ID..."
            />
            <button type="submit" aria-label="Search">
                <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
            </button>
        </form>

        <nav class="site-mobile-links" aria-label="Mobile navigation">
            <% (primaryNavLinks || []).forEach((navItem) => { %>
                <a
                    href="<%= navItem.href %>"
                    class="<%= (typeof activeNav !== 'undefined' && activeNav && activeNav.toLowerCase() === navItem.key.toLowerCase()) ? 'active' : '' %>"
                ><%= navItem.label %></a>
            <% }) %>
            <div class="site-mobile-divider" aria-hidden="true"></div>
            <a href="/shipping">Shipping &amp; Delivery</a>
            <a href="/authenticity">Artwork Authenticity</a>
            <a href="/admin/inventory">Inventory Registry</a>
            <a href="/contact">Contact &amp; Support</a>
            <a href="/cart">Shopping Bag (<span class="cart-count"><%= cart_count %></span>)</a>
        </nav>
    </div>
</header>

<script>
    (() => {
        const toggle = document.getElementById('siteMenuToggle');
        const drawer = document.getElementById('siteMobileDrawer');
        if (!toggle || !drawer) return;
        toggle.addEventListener('click', () => {
            const isOpen = drawer.classList.toggle('open');
            toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
    })();
</script>

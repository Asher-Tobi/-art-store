<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shopping Bag | ART STUDIO</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Playfair+Display:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --ink: #0a0a0a;
            --muted: #666666;
            --border: #dcdcdc;
            --card-border: #e5e5e5;
            --canvas: #fafafa;
            --surface: #ffffff;
            --gold: #a3702b;
            --green: #047857;
            --font-sans: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            --font-serif: "Playfair Display", Georgia, serif;
            --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: var(--font-sans);
            background: var(--canvas);
            color: var(--ink);
            -webkit-font-smoothing: antialiased;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        a { color: inherit; text-decoration: none; }
        button { font: inherit; }
        img { max-width: 100%; display: block; }

        .topbar {
            background: #111111;
            color: #ffffff;
            text-align: center;
            padding: 9px 16px;
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }

        .header {
            background: #ffffff;
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 40;
        }

        .header-inner {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
        }

        .brand-mark {
            font-family: var(--font-serif);
            font-size: 26px;
            font-weight: 400;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--ink);
            white-space: nowrap;
        }

        .back-link {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            color: #404040;
        }

        .back-link:hover { color: var(--ink); }

        .wrap {
            max-width: 1280px;
            width: 100%;
            margin: 0 auto;
            padding: 40px 24px 80px;
            flex: 1;
        }

        .page-heading {
            margin: 0 0 28px;
            padding-bottom: 18px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
        }

        .page-heading h1 {
            font-family: var(--font-serif);
            font-size: clamp(2rem, 3.5vw, 2.5rem);
            font-weight: 400;
            margin: 0;
        }

        .page-heading span {
            font-family: var(--font-mono);
            font-size: 12px;
            color: var(--muted);
        }

        .cart-layout {
            display: grid;
            grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
            gap: 36px;
            align-items: start;
        }

        .panel {
            background: var(--surface);
            border: 1px solid var(--border);
            padding: 28px;
        }

        .flash {
            padding: 12px 16px;
            background: #ecfdf5;
            border: 1px solid #a7f3d0;
            color: #065f46;
            font-size: 13px;
            margin-bottom: 20px;
        }

        .cart-item {
            display: grid;
            grid-template-columns: 110px 1fr auto;
            gap: 20px;
            padding: 20px 0;
            border-bottom: 1px solid #ececec;
            align-items: center;
        }

        .cart-item:first-child { padding-top: 0; }
        .cart-item:last-child { border-bottom: none; padding-bottom: 0; }

        .cart-thumb {
            width: 110px;
            aspect-ratio: 4 / 5;
            border: 1px solid var(--card-border);
            background: #fafafa;
            overflow: hidden;
        }

        .cart-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .item-artist {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.16em;
            color: var(--gold);
            margin-bottom: 4px;
        }

        .item-title {
            font-size: 16px;
            font-weight: 600;
            margin: 0 0 6px;
        }

        .item-details {
            color: var(--muted);
            font-size: 12px;
            line-height: 1.6;
        }

        .qty-controls {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 14px;
            flex-wrap: wrap;
        }

        .qty-controls input {
            width: 64px;
            padding: 7px 10px;
            border: 1px solid #cccccc;
            background: #fafafa;
            font-family: var(--font-mono);
            font-size: 13px;
        }

        .update-btn {
            padding: 8px 14px;
            background: #f5f5f5;
            border: 1px solid #cccccc;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            cursor: pointer;
        }

        .update-btn:hover { background: #e5e5e5; }

        .remove-btn {
            background: none;
            border: none;
            padding: 0;
            color: #737373;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            cursor: pointer;
            margin-left: 8px;
        }

        .remove-btn:hover { color: #b91c1c; }

        .price-col {
            text-align: right;
            font-family: var(--font-mono);
            font-variant-numeric: tabular-nums;
            font-size: 15px;
            font-weight: 600;
        }

        .summary-card {
            background: var(--surface);
            border: 1px solid var(--border);
            padding: 28px;
            position: sticky;
            top: 88px;
        }

        .summary-title {
            margin: 0 0 18px;
            padding-bottom: 14px;
            border-bottom: 1px solid var(--border);
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }

        .totals-line {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            font-size: 13px;
            color: #525252;
        }

        .totals-line .mono {
            font-family: var(--font-mono);
            font-weight: 600;
            color: var(--ink);
        }

        .totals-grand {
            padding-top: 16px;
            margin-top: 12px;
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            font-size: 16px;
            font-weight: 700;
        }

        .totals-grand .mono {
            font-family: var(--font-mono);
            font-size: 20px;
        }

        .checkout-btn {
            width: 100%;
            display: block;
            margin-top: 22px;
            padding: 16px 20px;
            background: #0a0a0a;
            color: #ffffff;
            text-align: center;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            transition: background-color 0.15s ease;
        }

        .checkout-btn:hover { background: #262626; }

        .checkout-note {
            margin: 12px 0 0;
            font-size: 11px;
            color: var(--muted);
            text-align: center;
            line-height: 1.5;
        }

        .empty {
            text-align: center;
            padding: 48px 20px;
        }

        .empty h2 {
            font-family: var(--font-serif);
            font-weight: 400;
            font-size: 24px;
            margin: 0 0 10px;
        }

        .empty p {
            color: var(--muted);
            font-size: 14px;
            margin: 0 0 22px;
        }

        .empty-btn {
            display: inline-block;
            padding: 14px 24px;
            background: #0a0a0a;
            color: #ffffff;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.12em;
        }

        .footer {
            background: #111111;
            color: #999999;
            border-top: 1px solid #262626;
            padding: 36px 24px;
            margin-top: auto;
        }

        .footer-inner {
            max-width: 1280px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            font-size: 12px;
        }

        .footer-links {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        .footer-links a:hover { color: #ffffff; }

        @media (max-width: 900px) {
            .cart-layout { grid-template-columns: 1fr; }
            .summary-card { position: static; }
        }

        @media (max-width: 600px) {
            .cart-item { grid-template-columns: 88px 1fr; }
            .cart-thumb { width: 88px; }
            .price-col { grid-column: 2; text-align: left; }
        }
    </style>
</head>
<body data-cid="<%= cid %>">
    <%- include('partials/site-header') %>

    <main class="wrap">
        <div class="page-heading">
            <h1>Shopping Bag</h1>
            <span><%= cart_items ? cart_items.reduce((s, i) => s + i.quantity, 0) : 0 %> Selected Works</span>
        </div>

        <div class="cart-layout">
            <section class="panel">
                <% if (messages && messages.length) { %>
                    <% messages.forEach((message) => { %>
                        <div class="flash" role="status"><%= message %></div>
                    <% }) %>
                <% } %>

                <% if (cart_items && cart_items.length) { %>
                    <% cart_items.forEach((item) => { %>
                    <div class="cart-item">
                        <a href="/product/<%= item.id %>" class="cart-thumb">
                            <img src="<%= item.image %>" alt="<%= item.title %>" referrerPolicy="no-referrer" />
                        </a>
                        <div>
                            <div class="item-artist"><a href="/artists/<%= getArtistSlug(item.artist) %>" style="text-decoration: none;"><%= item.artist %></a></div>
                            <h2 class="item-title"><a href="/product/<%= item.id %>"><%= item.title %></a></h2>
                            <div class="item-details">
                                <%= item.category %> · <%= item.size %>
                            </div>
                            <div class="qty-controls">
                                <form method="post" action="/cart" style="display:flex; align-items:center; gap:8px;">
                                    <input type="hidden" name="action" value="update" />
                                    <input type="hidden" name="product_id" value="<%= item.id %>" />
                                    <label for="qty-<%= item.id %>" style="font-size:11px; text-transform:uppercase; letter-spacing:0.08em; color:#525252;">Qty</label>
                                    <input id="qty-<%= item.id %>" type="number" name="quantity" min="0" value="<%= item.quantity %>" />
                                    <button type="submit" class="update-btn">Update</button>
                                </form>
                                <form method="post" action="/cart">
                                    <input type="hidden" name="action" value="remove" />
                                    <input type="hidden" name="product_id" value="<%= item.id %>" />
                                    <button type="submit" class="remove-btn">Remove</button>
                                </form>
                            </div>
                        </div>
                        <div class="price-col">
                            $<%= formatCurrency(item.price * item.quantity) %>
                        </div>
                    </div>
                    <% }) %>
                <% } else { %>
                    <div class="empty">
                        <h2>Your bag is currently empty</h2>
                        <p>Browse our complete archive of paintings, rare prints, photography, historical sculptures, and collectible furniture.</p>
                        <a href="/" class="empty-btn">Browse Archive</a>
                    </div>
                <% } %>
            </section>

            <aside class="summary-card">
                <h2 class="summary-title">Order Summary</h2>
                <div class="totals-line">
                    <span>Subtotal</span>
                    <span class="mono">$<%= formatCurrency(subtotal) %></span>
                </div>
                <div class="totals-line">
                    <span><%= (typeof shipping_details !== 'undefined' && shipping_details.hasFurniture) ? 'White-Glove Furniture Courier' : 'Insured Fine Art Delivery' %></span>
                    <span class="mono" style="<%= shipping === 0 && subtotal > 0 ? 'color: var(--green);' : '' %>">
                        <%= subtotal > 0 && shipping === 0 ? 'FREE' : '$' + formatCurrency(shipping) %>
                    </span>
                </div>
                <div class="totals-grand">
                    <span>Total</span>
                    <span class="mono">$<%= formatCurrency(total) %> USD</span>
                </div>

                <% if (subtotal > 0) { %>
                <div style="margin-top: 16px; padding: 11px 13px; background: <%= subtotal >= 1500 ? '#ecfdf5' : '#fcfaf6' %>; border: 1px solid <%= subtotal >= 1500 ? '#a7f3d0' : '#e6dcc8' %>; font-size: 12px; line-height: 1.5; color: <%= subtotal >= 1500 ? '#065f46' : '#404040' %>;">
                    <% if (subtotal >= 1500) { %>
                        <strong>✓ Complimentary Insured Worldwide Delivery Unlocked</strong>
                        <% if (typeof shipping_details !== 'undefined' && shipping_details.hasFurniture) { %>
                            <span style="display: block; margin-top: 2px;">Includes white-glove crated furniture freight &amp; signature placement.</span>
                        <% } %>
                    <% } else { %>
                        Add <strong>$<%= formatCurrency(1500 - subtotal) %></strong> more to unlock complimentary insured worldwide courier delivery (orders $1,500+).
                    <% } %>
                </div>
                <% } %>

                <% if (cart_items && cart_items.length) { %>
                    <a href="/checkout" class="checkout-btn">Proceed to Checkout</a>
                <% } else { %>
                    <a href="/" class="checkout-btn">Explore Collection</a>
                <% } %>

                <p class="checkout-note">
                    <a href="/shipping" style="text-decoration: underline; text-underline-offset: 3px;">Complimentary worldwide courier delivery</a> on orders $1,500+, including furniture &amp; international destinations.
                </p>
            </aside>
        </div>
    </main>

    <footer class="footer">
        <div class="footer-inner">
            <span>© 2026 ART STUDIO. All rights reserved.</span>
            <nav class="footer-links" aria-label="Footer policies">
                <a href="/artists">Meet the Artists</a>
                <a href="/shipping">Shipping &amp; Delivery</a>
                <a href="/authenticity">Authenticity</a>
                <a href="/crypto-checkout">Crypto Checkout</a>
                <a href="/terms">Terms</a>
                <a href="/privacy-policy">Privacy Policy</a>
                <a href="/contact">Contact &amp; Support</a>
            </nav>
        </div>
    </footer>

    <script src="/static/js/cart-sync.js"></script>
</body>
</html>

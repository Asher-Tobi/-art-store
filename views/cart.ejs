<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shopping Bag | ART STUDIO</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Playfair+Display:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --ink: #0a0a0a;
            --ink-soft: #404040;
            --muted: #666666;
            --border: #dcdcdc;
            --card-border: #e5e5e5;
            --canvas: #fafafa;
            --surface: #ffffff;
            --gold: #a3702b;
            --green: #047857;
            --danger: #991b1b;
            --font-sans: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            --font-serif: "Playfair Display", Georgia, serif;
            --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: var(--font-sans);
            background: var(--canvas);
            color: var(--ink);
            -webkit-font-smoothing: antialiased;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        a { color: inherit; text-decoration: none; }
        button { font: inherit; }
        img { max-width: 100%; display: block; }

        .topbar {
            background: #111111;
            color: #ffffff;
            text-align: center;
            padding: 9px 16px;
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }

        .header {
            background: #ffffff;
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 40;
        }

        .header-inner {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
        }

        .brand-mark {
            font-family: var(--font-serif);
            font-size: 26px;
            font-weight: 400;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--ink);
            white-space: nowrap;
        }

        .wrap {
            max-width: 1280px;
            width: 100%;
            margin: 0 auto;
            padding: 36px 24px 80px;
            flex: 1;
        }

        .breadcrumb-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 18px;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: var(--muted);
        }

        .breadcrumb-row a:hover { color: var(--ink); }

        .page-heading {
            margin: 0 0 28px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
        }

        .page-heading h1 {
            font-family: var(--font-serif);
            font-size: clamp(2rem, 3.4vw, 2.65rem);
            font-weight: 400;
            letter-spacing: -0.02em;
            margin: 0;
        }

        .page-count {
            font-family: var(--font-mono);
            font-size: 12px;
            color: var(--muted);
            font-variant-numeric: tabular-nums;
        }

        .cart-layout {
            display: grid;
            grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
            gap: 36px;
            align-items: start;
        }

        .panel {
            background: var(--surface);
            border: 1px solid var(--border);
            padding: 28px;
        }

        .flash {
            padding: 13px 16px;
            background: #f6faf7;
            border: 1px solid #cce3d6;
            color: #165b3d;
            font-size: 13px;
            line-height: 1.5;
            margin-bottom: 20px;
        }

        .flash.error {
            background: #fef2f2;
            border-color: #fecaca;
            color: var(--danger);
        }

        .bag-list-header {
            display: grid;
            grid-template-columns: 1fr auto;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border);
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            color: var(--muted);
        }

        .cart-item {
            display: grid;
            grid-template-columns: 112px minmax(0, 1fr) auto;
            gap: 22px;
            padding: 24px 0;
            border-bottom: 1px solid #ebebeb;
            align-items: start;
        }

        .cart-item:last-child {
            border-bottom: none;
            padding-bottom: 4px;
        }

        .cart-thumb {
            width: 112px;
            aspect-ratio: 4 / 5;
            border: 1px solid var(--card-border);
            background: #f3f3f3;
            overflow: hidden;
            display: block;
        }

        .cart-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .item-artist {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.16em;
            color: var(--gold);
            margin-bottom: 5px;
        }

        .item-title {
            font-family: var(--font-serif);
            font-size: 19px;
            font-weight: 400;
            line-height: 1.3;
            margin: 0 0 8px;
        }

        .item-meta {
            color: var(--muted);
            font-size: 12px;
            line-height: 1.6;
        }

        .item-inv-row {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
            margin-top: 6px;
            font-family: var(--font-mono);
            font-size: 11px;
            color: #404040;
        }

        .item-inv-row a {
            text-decoration: underline;
            text-underline-offset: 3px;
            color: var(--ink);
        }

        .qty-actions-row {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            margin-top: 16px;
        }

        .qty-stepper {
            display: inline-flex;
            align-items: center;
            border: 1px solid #cccccc;
            background: #fafafa;
            height: 36px;
        }

        .qty-step-btn {
            width: 34px;
            height: 100%;
            border: none;
            background: transparent;
            color: var(--ink);
            font-size: 15px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: background-color 0.15s ease;
        }

        .qty-step-btn:hover { background: #ececec; }

        .qty-input {
            width: 44px;
            height: 100%;
            border: none;
            border-left: 1px solid #e0e0e0;
            border-right: 1px solid #e0e0e0;
            background: #ffffff;
            text-align: center;
            font-family: var(--font-mono);
            font-size: 12px;
            font-variant-numeric: tabular-nums;
            color: var(--ink);
            -moz-appearance: textfield;
        }

        .qty-input::-webkit-inner-spin-button,
        .qty-input::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        .update-btn {
            padding: 8px 12px;
            background: #f5f5f5;
            border: 1px solid #cccccc;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            cursor: pointer;
        }

        .update-btn:hover { background: #e5e5e5; }

        .remove-btn {
            background: none;
            border: none;
            padding: 4px 0;
            color: #666666;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            cursor: pointer;
            text-decoration: underline;
            text-underline-offset: 3px;
        }

        .remove-btn:hover { color: var(--danger); }

        .price-col {
            text-align: right;
            font-family: var(--font-mono);
            font-variant-numeric: tabular-nums;
        }

        .line-total {
            font-size: 15px;
            font-weight: 600;
            color: var(--ink);
        }

        .unit-price {
            display: block;
            margin-top: 4px;
            font-size: 11px;
            color: var(--muted);
        }

        .summary-card {
            background: var(--surface);
            border: 1px solid var(--border);
            padding: 28px;
            position: sticky;
            top: 88px;
        }

        .summary-title {
            margin: 0 0 18px;
            padding-bottom: 14px;
            border-bottom: 1px solid var(--border);
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.12em;
        }

        .totals-line {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 12px;
            margin-bottom: 13px;
            font-size: 13px;
            color: #525252;
        }

        .totals-line .mono {
            font-family: var(--font-mono);
            font-variant-numeric: tabular-nums;
            font-weight: 600;
            color: var(--ink);
            white-space: nowrap;
        }

        .totals-subnote {
            display: block;
            font-size: 11px;
            color: var(--muted);
            margin-top: 2px;
            line-height: 1.45;
        }

        .totals-grand {
            padding-top: 16px;
            margin-top: 14px;
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            font-size: 15px;
            font-weight: 700;
        }

        .totals-grand .mono {
            font-family: var(--font-mono);
            font-variant-numeric: tabular-nums;
            font-size: 20px;
        }

        .shipping-tier-box {
            margin-top: 18px;
            padding: 13px 15px;
            border: 1px solid #e2ddd3;
            background: #fcfaf6;
            font-size: 12px;
            line-height: 1.55;
            color: #404040;
        }

        .shipping-tier-box.unlocked {
            background: #f6faf7;
            border-color: #cce3d6;
            color: #165b3d;
        }

        .checkout-btn {
            width: 100%;
            display: block;
            margin-top: 22px;
            padding: 17px 20px;
            background: #0a0a0a;
            color: #ffffff;
            text-align: center;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.16em;
            transition: background-color 0.15s ease;
        }

        .checkout-btn:hover { background: #262626; }

        .trust-links {
            margin-top: 20px;
            padding-top: 16px;
            border-top: 1px solid #ececec;
            display: flex;
            flex-direction: column;
            gap: 8px;
            font-size: 11px;
            color: var(--muted);
        }

        .trust-links a {
            text-decoration: underline;
            text-underline-offset: 3px;
            color: #404040;
        }

        .trust-links a:hover { color: var(--ink); }

        .empty {
            text-align: center;
            padding: 56px 20px;
        }

        .empty h2 {
            font-family: var(--font-serif);
            font-weight: 400;
            font-size: 26px;
            margin: 0 0 12px;
        }

        .empty p {
            color: var(--muted);
            font-size: 14px;
            line-height: 1.65;
            max-width: 460px;
            margin: 0 auto 24px;
        }

        .empty-btn {
            display: inline-block;
            padding: 15px 28px;
            background: #0a0a0a;
            color: #ffffff;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.14em;
        }

        .empty-btn:hover { background: #262626; }

        .footer {
            background: #111111;
            color: #999999;
            border-top: 1px solid #262626;
            padding: 36px 24px;
            margin-top: auto;
        }

        .footer-inner {
            max-width: 1280px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            font-size: 12px;
        }

        .footer-links {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        .footer-links a:hover { color: #ffffff; }

        .hidden { display: none !important; }

        @media (max-width: 900px) {
            .cart-layout { grid-template-columns: 1fr; }
            .summary-card { position: static; }
        }

        @media (max-width: 600px) {
            .wrap { padding: 24px 16px 60px; }
            .panel, .summary-card { padding: 20px; }
            .cart-item { grid-template-columns: 88px minmax(0, 1fr); gap: 16px; }
            .cart-thumb { width: 88px; }
            .price-col { grid-column: 2; text-align: left; }
        }
    </style>
</head>
<body data-cid="<%= cid %>">
    <%- include('partials/site-header') %>

    <main class="wrap">
        <div class="breadcrumb-row">
            <div>
                <a href="/">Catalogue</a>
                <span aria-hidden="true"> · </span>
                <span>Shopping Bag</span>
            </div>
            <a href="/">Continue Browsing Collection</a>
        </div>

        <div class="page-heading">
            <h1>Shopping Bag</h1>
            <span class="page-count" id="bagCountHeading">
                <%= cart_items ? cart_items.reduce((s, i) => s + i.quantity, 0) : 0 %> Selected <%= (cart_items && cart_items.reduce((s, i) => s + i.quantity, 0) === 1) ? 'Work' : 'Works' %>
            </span>
        </div>

        <div class="cart-layout">
            <section class="panel" aria-label="Selected artworks in your bag">
                <% if (messages && messages.length) { %>
                    <% messages.forEach((message) => { %>
                        <div class="flash" role="status"><%= message %></div>
                    <% }) %>
                <% } %>
                <div class="flash error hidden" id="bagErrorBanner" role="alert"></div>

                <% if (cart_items && cart_items.length) { %>
                    <div class="bag-list-header" id="bagListHeader">
                        <span>Artwork &amp; Provenance</span>
                        <span>Subtotal</span>
                    </div>

                    <div id="bagItemsList">
                        <% cart_items.forEach((item) => { %>
                        <article class="cart-item" data-product-id="<%= item.id %>">
                            <a href="/product/<%= item.id %>" class="cart-thumb">
                                <img src="<%= item.image %>" alt="<%= item.title %>" referrerPolicy="no-referrer" />
                            </a>

                            <div>
                                <div class="item-artist">
                                    <a href="/artists/<%= getArtistSlug(item.artist) %>"><%= item.artist %></a>
                                </div>
                                <h2 class="item-title">
                                    <a href="/product/<%= item.id %>"><%= item.title %></a>
                                </h2>
                                <div class="item-meta">
                                    <%= item.category %> · <%= item.size %>
                                </div>
                                <% if (item.inventory_id) { %>
                                <div class="item-inv-row">
                                    <span>Inventory ID: <%= item.inventory_id %></span>
                                    <span>·</span>
                                    <a href="/certificate/<%= encodeURIComponent(item.inventory_id) %>">Artwork Documentation</a>
                                </div>
                                <% } %>

                                <div class="qty-actions-row">
                                    <form method="post" action="/cart" class="qty-update-form" data-product-id="<%= item.id %>" style="display:flex; align-items:center; gap:8px;">
                                        <input type="hidden" name="action" value="update" />
                                        <input type="hidden" name="product_id" value="<%= item.id %>" />
                                        <div class="qty-stepper" aria-label="Quantity selector for <%= item.title %>">
                                            <button type="button" class="qty-step-btn" data-step="-1" aria-label="Decrease quantity">−</button>
                                            <input
                                                id="qty-<%= item.id %>"
                                                class="qty-input"
                                                type="number"
                                                name="quantity"
                                                min="1"
                                                max="20"
                                                value="<%= item.quantity %>"
                                                aria-label="Quantity"
                                            />
                                            <button type="button" class="qty-step-btn" data-step="1" aria-label="Increase quantity">+</button>
                                        </div>
                                        <noscript>
                                            <button type="submit" class="update-btn">Update</button>
                                        </noscript>
                                    </form>

                                    <form method="post" action="/cart" class="remove-item-form" data-product-id="<%= item.id %>">
                                        <input type="hidden" name="action" value="remove" />
                                        <input type="hidden" name="product_id" value="<%= item.id %>" />
                                        <button type="submit" class="remove-btn">Remove</button>
                                    </form>
                                </div>
                            </div>

                            <div class="price-col">
                                <div class="line-total" data-line-total="<%= item.id %>">$<%= formatCurrency(item.price * item.quantity) %></div>
                                <% if (item.quantity > 1) { %>
                                    <span class="unit-price" data-unit-price="<%= item.id %>">$<%= formatCurrency(item.price) %> each</span>
                                <% } else { %>
                                    <span class="unit-price hidden" data-unit-price="<%= item.id %>">$<%= formatCurrency(item.price) %> each</span>
                                <% } %>
                            </div>
                        </article>
                        <% }) %>
                    </div>
                <% } %>

                <div class="empty <%= (cart_items && cart_items.length) ? 'hidden' : '' %>" id="emptyBagState">
                    <h2>Your bag is currently empty</h2>
                    <p>Browse our complete archive of paintings, rare prints, photography, historical sculptures, and collectible furniture.</p>
                    <a href="/" class="empty-btn">Browse Archive</a>
                </div>
            </section>

            <aside class="summary-card" aria-label="Order summary">
                <h2 class="summary-title">Order Summary</h2>

                <div class="totals-line">
                    <span>Subtotal</span>
                    <span class="mono" id="summarySubtotal">$<%= formatCurrency(subtotal) %></span>
                </div>

                <div class="totals-line">
                    <div>
                        <span id="summaryShippingLabel">
                            <%= (typeof shipping_details !== 'undefined' && shipping_details.hasFurniture) ? 'White-Glove Furniture Courier (Est.)' : 'Insured Fine Art Courier (Est.)' %>
                        </span>
                        <span class="totals-subnote" id="summaryShippingSubnote">
                            <% if (typeof shipping_details !== 'undefined') { %>
                                <%= shipping_details.cratingWindow %> · <%= shipping_details.transitWindow %>
                            <% } %>
                        </span>
                    </div>
                    <span class="mono" id="summaryShippingValue" style="<%= shipping === 0 && subtotal > 0 ? 'color: var(--green);' : '' %>">
                        <%= subtotal > 0 && shipping === 0 ? 'FREE' : '$' + formatCurrency(shipping) %>
                    </span>
                </div>

                <div class="totals-line">
                    <div>
                        <span>Estimated Taxes &amp; Fees</span>
                        <span class="totals-subnote">Assessed by destination; customs duties if international</span>
                    </div>
                    <span class="mono" id="summaryTaxValue">$0.00</span>
                </div>

                <div class="totals-grand">
                    <span>Total</span>
                    <span class="mono" id="summaryGrandTotal">$<%= formatCurrency(total) %> USD</span>
                </div>

                <div class="shipping-tier-box <%= subtotal >= 1500 ? 'unlocked' : '' %> <%= subtotal > 0 ? '' : 'hidden' %>" id="shippingTierBanner">
                    <% if (subtotal >= 1500) { %>
                        <strong>Complimentary Insured Worldwide Delivery Unlocked</strong>
                        <% if (typeof shipping_details !== 'undefined' && shipping_details.hasFurniture) { %>
                            <span style="display: block; margin-top: 3px;">Includes white-glove crated furniture freight &amp; room-of-choice placement.</span>
                        <% } %>
                    <% } else if (subtotal > 0) { %>
                        Add <strong>$<%= formatCurrency(1500 - subtotal) %></strong> more for complimentary insured worldwide courier delivery (orders $1,500+).
                    <% } %>
                </div>

                <a
                    href="<%= (cart_items && cart_items.length) ? '/checkout' : '/' %>"
                    class="checkout-btn"
                    id="primaryBagCta"
                >
                    <%= (cart_items && cart_items.length) ? 'Proceed to Checkout' : 'Explore Collection' %>
                </a>

                <div class="trust-links">
                    <span><a href="/shipping">Shipping &amp; Crating Guide</a> · Complimentary worldwide on orders $1,500+</span>
                    <span><a href="/authenticity">Provenance &amp; Documentation</a> · Cataloged by ART STUDIO Inventory ID</span>
                    <span><a href="/terms">14-Day Return Policy</a> · <a href="/contact">Collector Support</a></span>
                </div>
            </aside>
        </div>
    </main>

    <footer class="footer">
        <div class="footer-inner">
            <span>© 2026 ART STUDIO. All rights reserved.</span>
            <nav class="footer-links" aria-label="Footer policies">
                <a href="/artists">Meet the Artists</a>
                <a href="/crypto-checkout">Crypto Checkout</a>
                <a href="/shipping">Shipping &amp; Delivery</a>
                <a href="/authenticity">Authenticity</a>
                <a href="/terms">Terms</a>
                <a href="/privacy-policy">Privacy Policy</a>
                <a href="/contact">Contact &amp; Support</a>
            </nav>
        </div>
    </footer>

    <script src="/static/js/cart-sync.js"></script>
    <script>
        (() => {
            const errorBanner = document.getElementById('bagErrorBanner');
            const itemsListEl = document.getElementById('bagItemsList');
            const listHeaderEl = document.getElementById('bagListHeader');
            const emptyStateEl = document.getElementById('emptyBagState');
            const countHeadingEl = document.getElementById('bagCountHeading');
            const subtotalEl = document.getElementById('summarySubtotal');
            const shippingLabelEl = document.getElementById('summaryShippingLabel');
            const shippingSubnoteEl = document.getElementById('summaryShippingSubnote');
            const shippingValEl = document.getElementById('summaryShippingValue');
            const taxValEl = document.getElementById('summaryTaxValue');
            const grandTotalEl = document.getElementById('summaryGrandTotal');
            const tierBannerEl = document.getElementById('shippingTierBanner');
            const primaryCtaEl = document.getElementById('primaryBagCta');

            function fmt(amount) {
                return Number(amount || 0).toLocaleString('en-US', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
            }

            function showError(msg) {
                if (!errorBanner) return;
                if (!msg) {
                    errorBanner.textContent = '';
                    errorBanner.classList.add('hidden');
                    return;
                }
                errorBanner.textContent = msg;
                errorBanner.classList.remove('hidden');
            }

            function syncDomFromCartPayload(data) {
                if (!data) return;
                const items = Array.isArray(data.items) ? data.items : [];
                const totalQty = typeof data.cart_count === 'number'
                    ? data.cart_count
                    : items.reduce((sum, item) => sum + (item.quantity || 0), 0);

                document.querySelectorAll('.cart-count').forEach((badge) => {
                    badge.textContent = String(totalQty);
                });

                if (countHeadingEl) {
                    countHeadingEl.textContent = totalQty + ' Selected ' + (totalQty === 1 ? 'Work' : 'Works');
                }

                const byId = new Map(items.map((item) => [String(item.id), item]));
                document.querySelectorAll('.cart-item[data-product-id]').forEach((row) => {
                    const pid = row.getAttribute('data-product-id') || '';
                    const updatedItem = byId.get(pid);
                    if (!updatedItem) {
                        row.remove();
                        return;
                    }
                    const qtyInput = row.querySelector('.qty-input');
                    if (qtyInput) qtyInput.value = String(updatedItem.quantity);
                    const lineTotalEl = row.querySelector('[data-line-total]');
                    if (lineTotalEl) {
                        lineTotalEl.textContent = '$' + fmt(updatedItem.price * updatedItem.quantity);
                    }
                    const unitPriceEl = row.querySelector('[data-unit-price]');
                    if (unitPriceEl) {
                        unitPriceEl.textContent = '$' + fmt(updatedItem.price) + ' each';
                        unitPriceEl.classList.toggle('hidden', updatedItem.quantity <= 1);
                    }
                });

                const isEmpty = items.length === 0;
                if (listHeaderEl) listHeaderEl.classList.toggle('hidden', isEmpty);
                if (itemsListEl) itemsListEl.classList.toggle('hidden', isEmpty);
                if (emptyStateEl) emptyStateEl.classList.toggle('hidden', !isEmpty);

                const subtotal = Number(data.subtotal || 0);
                const shipping = Number(data.shipping || 0);
                const tax = Number(data.tax || 0);
                const total = Number(data.total || 0);
                const sd = data.shipping_details || {};

                if (subtotalEl) subtotalEl.textContent = '$' + fmt(subtotal);
                if (taxValEl) taxValEl.textContent = '$' + fmt(tax);
                if (grandTotalEl) grandTotalEl.textContent = '$' + fmt(total) + ' USD';

                if (shippingLabelEl) {
                    shippingLabelEl.textContent = sd.hasFurniture
                        ? 'White-Glove Furniture Courier (Est.)'
                        : 'Insured Fine Art Courier (Est.)';
                }
                if (shippingSubnoteEl && sd.cratingWindow && sd.transitWindow) {
                    shippingSubnoteEl.textContent = sd.cratingWindow + ' · ' + sd.transitWindow;
                }
                if (shippingValEl) {
                    const isFree = subtotal > 0 && shipping === 0;
                    shippingValEl.textContent = isFree ? 'FREE' : '$' + fmt(shipping);
                    shippingValEl.style.color = isFree ? 'var(--green)' : '';
                }

                if (tierBannerEl) {
                    if (subtotal <= 0) {
                        tierBannerEl.classList.add('hidden');
                        tierBannerEl.classList.remove('unlocked');
                        tierBannerEl.innerHTML = '';
                    } else if (subtotal >= 1500) {
                        tierBannerEl.classList.remove('hidden');
                        tierBannerEl.classList.add('unlocked');
                        tierBannerEl.innerHTML =
                            '<strong>Complimentary Insured Worldwide Delivery Unlocked</strong>' +
                            (sd.hasFurniture
                                ? '<span style="display:block;margin-top:3px;">Includes white-glove crated furniture freight &amp; room-of-choice placement.</span>'
                                : '');
                    } else {
                        tierBannerEl.classList.remove('hidden');
                        tierBannerEl.classList.remove('unlocked');
                        tierBannerEl.innerHTML =
                            'Add <strong>$' + fmt(1500 - subtotal) + '</strong> more for complimentary insured worldwide courier delivery (orders $1,500+).';
                    }
                }

                if (primaryCtaEl) {
                    const activeCid = data.cid || document.body?.dataset?.cid || '';
                    const baseHref = isEmpty ? '/' : '/checkout';
                    primaryCtaEl.href = activeCid
                        ? baseHref + '?cid=' + encodeURIComponent(activeCid)
                        : baseHref;
                    primaryCtaEl.textContent = isEmpty ? 'Explore Collection' : 'Proceed to Checkout';
                }
            }

            async function postCartMutation(endpoint, payload) {
                showError('');
                const activeCid = document.body?.dataset?.cid || '';
                const res = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ ...payload, cid: activeCid })
                });
                const data = await res.json();
                if (!res.ok || !data.ok) {
                    throw new Error(data?.error || 'Unable to update shopping bag.');
                }
                syncDomFromCartPayload(data);
            }

            document.querySelectorAll('.remove-item-form').forEach((form) => {
                form.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const productId = form.getAttribute('data-product-id') || '';
                    const btn = form.querySelector('.remove-btn');
                    if (btn) btn.disabled = true;
                    try {
                        await postCartMutation('/api/cart/remove', { product_id: productId });
                    } catch (err) {
                        showError(err instanceof Error ? err.message : 'Could not remove item.');
                        if (btn) btn.disabled = false;
                    }
                });
            });

            document.querySelectorAll('.qty-update-form').forEach((form) => {
                const productId = form.getAttribute('data-product-id') || '';
                const input = form.querySelector('.qty-input');
                let prevVal = input ? Number.parseInt(input.value || '1', 10) : 1;

                async function commitQty(nextQty) {
                    const clamped = Math.max(1, Math.min(20, nextQty));
                    if (input) input.value = String(clamped);
                    try {
                        await postCartMutation('/api/cart/update', {
                            product_id: productId,
                            quantity: clamped
                        });
                        prevVal = clamped;
                    } catch (err) {
                        if (input) input.value = String(prevVal);
                        showError(err instanceof Error ? err.message : 'Could not update quantity.');
                    }
                }

                form.querySelectorAll('.qty-step-btn').forEach((btn) => {
                    btn.addEventListener('click', () => {
                        const delta = Number.parseInt(btn.getAttribute('data-step') || '0', 10);
                        const current = input ? Number.parseInt(input.value || '1', 10) || 1 : 1;
                        if (current + delta <= 0) {
                            postCartMutation('/api/cart/remove', { product_id: productId }).catch((err) => {
                                showError(err instanceof Error ? err.message : 'Could not remove item.');
                            });
                            return;
                        }
                        commitQty(current + delta);
                    });
                });

                if (input) {
                    input.addEventListener('change', () => {
                        const parsed = Number.parseInt(input.value || '1', 10);
                        if (!Number.isFinite(parsed) || parsed <= 0) {
                            input.value = String(prevVal);
                            showError('Please enter a quantity between 1 and 20, or click Remove.');
                            return;
                        }
                        commitQty(parsed);
                    });
                }

                form.addEventListener('submit', (e) => {
                    e.preventDefault();
                    const parsed = input ? Number.parseInt(input.value || '1', 10) : 1;
                    commitQty(Number.isFinite(parsed) ? parsed : 1);
                });
            });
        })();
    </script>
</body>
</html>

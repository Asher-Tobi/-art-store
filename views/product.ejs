<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%= product.title %> by <%= product.artist %> — available at ART STUDIO.">
    <title><%= product.title %> | ART STUDIO</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Playfair+Display:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --ink: #0a0a0a;
            --ink-soft: #404040;
            --muted: #666666;
            --border: #dcdcdc;
            --card-border: #e5e5e5;
            --surface: #ffffff;
            --canvas: #fafafa;
            --gold: #a3702b;
            --green: #047857;
            --font-sans: "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            --font-serif: "Playfair Display", Georgia, serif;
            --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: var(--font-sans);
            background: var(--surface);
            color: var(--ink);
            -webkit-font-smoothing: antialiased;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        a { color: inherit; text-decoration: none; }
        button { font: inherit; }
        img { max-width: 100%; display: block; }

        .topbar {
            background: #111111;
            color: #ffffff;
            text-align: center;
            padding: 9px 16px;
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }

        .header {
            background: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(8px);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 40;
        }

        .header-inner {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 32px;
        }

        .brand-mark {
            font-family: var(--font-serif);
            font-size: 26px;
            font-weight: 400;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--ink);
            white-space: nowrap;
        }

        .nav {
            display: flex;
            align-items: center;
            gap: 28px;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--ink-soft);
        }

        .nav a:hover {
            color: var(--ink);
            text-decoration: underline;
            text-underline-offset: 6px;
        }

        .bag-trigger {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            font-size: 12px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            border-radius: 2px;
        }

        .bag-trigger:hover { background: #f5f5f5; }

        .bag-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 20px;
            height: 20px;
            border-radius: 9999px;
            background: #171717;
            color: #ffffff;
            font-family: var(--font-mono);
            font-size: 11px;
            font-weight: 600;
        }

        .main-wrap {
            max-width: 1280px;
            width: 100%;
            margin: 0 auto;
            padding: 36px 24px 80px;
            flex: 1;
        }

        .breadcrumb {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: #737373;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 28px;
            flex-wrap: wrap;
        }

        .breadcrumb a:hover { color: var(--ink); }
        .breadcrumb .current { color: var(--ink); font-weight: 500; }

        .pdp-grid {
            display: grid;
            grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
            gap: 48px;
            align-items: start;
        }

        .artwork-gallery {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .artwork-frame {
            position: relative;
            aspect-ratio: 4 / 5;
            background: #f9f9f8;
            border: 1px solid var(--card-border);
            border-radius: 2px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 18px;
            cursor: zoom-in;
            user-select: none;
        }

        .artwork-frame.inline-zoomed {
            cursor: zoom-out;
        }

        .artwork-frame img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            transition: transform 0.2s ease-out;
            transform-origin: center center;
            will-change: transform;
        }

        .artwork-frame.inline-zoomed img {
            transform: scale(2.25);
        }

        .artwork-tag {
            position: absolute;
            top: 14px;
            left: 14px;
            z-index: 3;
            font-family: var(--font-mono);
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            background: rgba(255, 255, 255, 0.95);
            border: 1px solid #d4d4d4;
            padding: 4px 10px;
            border-radius: 2px;
            pointer-events: none;
        }

        .gallery-tools {
            position: absolute;
            top: 14px;
            right: 14px;
            z-index: 4;
            display: flex;
            gap: 8px;
        }

        .gallery-tool-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(255, 255, 255, 0.95);
            color: var(--ink);
            border: 1px solid #d4d4d4;
            border-radius: 2px;
            padding: 6px 10px;
            font-family: var(--font-mono);
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            cursor: pointer;
            transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
        }

        .gallery-tool-btn:hover,
        .gallery-tool-btn.active {
            background: #0a0a0a;
            color: #ffffff;
            border-color: #0a0a0a;
        }

        .gallery-nav-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            z-index: 4;
            width: 38px;
            height: 38px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.92);
            color: var(--ink);
            border: 1px solid #d4d4d4;
            border-radius: 2px;
            cursor: pointer;
            transition: background-color 0.15s ease, color 0.15s ease, opacity 0.15s ease;
        }

        .gallery-nav-btn:hover {
            background: #0a0a0a;
            color: #ffffff;
            border-color: #0a0a0a;
        }

        .gallery-nav-btn.prev { left: 14px; }
        .gallery-nav-btn.next { right: 14px; }

        .artwork-frame.inline-zoomed .gallery-nav-btn {
            opacity: 0;
            pointer-events: none;
        }

        .view-counter {
            position: absolute;
            bottom: 14px;
            right: 14px;
            z-index: 3;
            background: rgba(10, 10, 10, 0.78);
            color: #ffffff;
            font-family: var(--font-mono);
            font-size: 11px;
            padding: 5px 10px;
            border-radius: 2px;
            pointer-events: none;
        }

        .zoom-hint {
            position: absolute;
            bottom: 14px;
            left: 14px;
            z-index: 3;
            background: rgba(255, 255, 255, 0.92);
            color: #404040;
            border: 1px solid #e5e5e5;
            font-family: var(--font-mono);
            font-size: 10px;
            padding: 5px 9px;
            border-radius: 2px;
            pointer-events: none;
        }

        .thumb-strip {
            display: flex;
            gap: 10px;
            overflow-x: auto;
            padding-bottom: 4px;
            scroll-snap-type: x proximity;
        }

        .thumb-strip::-webkit-scrollbar {
            height: 6px;
        }

        .thumb-strip::-webkit-scrollbar-thumb {
            background: #d4d4d4;
            border-radius: 2px;
        }

        .thumb-btn {
            position: relative;
            flex: 0 0 88px;
            aspect-ratio: 4 / 5;
            background: #f9f9f8;
            border: 1px solid var(--card-border);
            border-radius: 2px;
            padding: 4px;
            cursor: pointer;
            overflow: hidden;
            scroll-snap-align: start;
            transition: border-color 0.15s ease, transform 0.15s ease;
        }

        .thumb-btn:hover {
            border-color: #737373;
        }

        .thumb-btn.active {
            border: 2px solid #0a0a0a;
        }

        .thumb-btn img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Lightbox Full-Screen Zoom Modal */
        .lightbox {
            position: fixed;
            inset: 0;
            z-index: 100;
            background: rgba(10, 10, 10, 0.96);
            color: #ffffff;
            display: none;
            flex-direction: column;
        }

        .lightbox.open {
            display: flex;
        }

        .lightbox-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 14px 24px;
            border-bottom: 1px solid #262626;
        }

        .lightbox-meta {
            display: flex;
            align-items: baseline;
            gap: 14px;
            min-width: 0;
        }

        .lightbox-title {
            font-family: var(--font-serif);
            font-size: 18px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .lightbox-counter {
            font-family: var(--font-mono);
            font-size: 11px;
            color: #a3a3a3;
            flex-shrink: 0;
        }

        .lightbox-controls {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }

        .lb-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            height: 36px;
            padding: 0 12px;
            background: #1a1a1a;
            color: #ffffff;
            border: 1px solid #333333;
            border-radius: 2px;
            font-family: var(--font-mono);
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.15s ease, border-color 0.15s ease;
        }

        .lb-btn:hover {
            background: #2e2e2e;
            border-color: #525252;
        }

        .lightbox-stage {
            position: relative;
            flex: 1;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 72px;
            cursor: zoom-in;
        }

        .lightbox-stage.is-zoomed {
            cursor: grab;
        }

        .lightbox-stage.is-dragging {
            cursor: grabbing;
        }

        .lightbox-stage img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            user-select: none;
            -webkit-user-drag: none;
            transform-origin: center center;
            transition: transform 0.16s ease-out;
        }

        .lightbox-stage.is-dragging img {
            transition: none;
        }

        .lb-arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            z-index: 4;
            width: 44px;
            height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(23, 23, 23, 0.85);
            color: #ffffff;
            border: 1px solid #404040;
            border-radius: 2px;
            cursor: pointer;
        }

        .lb-arrow:hover {
            background: #ffffff;
            color: #0a0a0a;
            border-color: #ffffff;
        }

        .lb-arrow.prev { left: 18px; }
        .lb-arrow.next { right: 18px; }

        .lightbox-thumbs {
            display: flex;
            justify-content: center;
            gap: 10px;
            padding: 12px 24px 18px;
            border-top: 1px solid #262626;
            overflow-x: auto;
        }

        .lb-thumb {
            flex: 0 0 60px;
            aspect-ratio: 4 / 5;
            padding: 2px;
            background: #171717;
            border: 1px solid #333333;
            border-radius: 2px;
            cursor: pointer;
            opacity: 0.65;
            overflow: hidden;
        }

        .lb-thumb:hover,
        .lb-thumb.active {
            opacity: 1;
            border: 2px solid #ffffff;
        }

        .lb-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .purchase-panel {
            border: 1px solid var(--card-border);
            background: #ffffff;
            padding: 32px;
            border-radius: 2px;
            position: sticky;
            top: 88px;
        }

        .pdp-artist {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            color: var(--gold);
            margin: 0 0 8px;
        }

        .pdp-title {
            font-family: var(--font-serif);
            font-size: clamp(1.9rem, 3vw, 2.5rem);
            font-weight: 400;
            line-height: 1.15;
            margin: 0 0 14px;
            color: var(--ink);
            text-wrap: balance;
        }

        .pdp-price-row {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            padding-bottom: 20px;
            margin-bottom: 20px;
            border-bottom: 1px solid var(--card-border);
        }

        .pdp-price {
            font-family: var(--font-mono);
            font-variant-numeric: tabular-nums;
            font-size: 24px;
            font-weight: 600;
            color: var(--ink);
        }

        .pdp-avail {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--green);
        }

        .pdp-desc {
            font-size: 14px;
            line-height: 1.75;
            color: #525252;
            margin: 0 0 24px;
        }

        .specs-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            padding: 18px 0;
            margin-bottom: 24px;
            border-top: 1px solid var(--card-border);
            border-bottom: 1px solid var(--card-border);
        }

        .spec-label {
            display: block;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: #737373;
            margin-bottom: 4px;
        }

        .spec-val {
            font-size: 13px;
            font-weight: 600;
            color: var(--ink);
        }

        .provenance-dossier {
            margin: 0 0 24px;
            padding: 16px 18px;
            background: var(--canvas);
            border: 1px solid var(--card-border);
            border-radius: 2px;
        }

        .provenance-dossier-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 12px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--card-border);
        }

        .provenance-dossier-title {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            color: var(--ink);
            margin: 0;
        }

        .provenance-badge {
            font-family: var(--font-mono);
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--gold);
        }

        .provenance-list {
            display: flex;
            flex-direction: column;
            gap: 9px;
            font-size: 12.5px;
            line-height: 1.55;
            color: #404040;
        }

        .provenance-row {
            display: grid;
            grid-template-columns: 92px 1fr;
            gap: 10px;
            align-items: baseline;
        }

        .provenance-key {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #737373;
        }

        .add-cart-form {
            display: flex;
            gap: 12px;
            align-items: end;
        }

        .qty-field label {
            display: block;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #404040;
            margin-bottom: 6px;
        }

        .qty-field input {
            width: 80px;
            height: 48px;
            padding: 0 12px;
            border: 1px solid #cccccc;
            background: #fafafa;
            font-family: var(--font-mono);
            font-size: 14px;
            border-radius: 2px;
        }

        .add-btn {
            flex: 1;
            height: 48px;
            background: #0a0a0a;
            color: #ffffff;
            border: none;
            border-radius: 2px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            cursor: pointer;
            transition: background-color 0.15s ease;
        }

        .add-btn:hover { background: #262626; }

        .flash {
            margin: 0 0 18px;
            padding: 12px 14px;
            background: #ecfdf5;
            border: 1px solid #a7f3d0;
            color: #065f46;
            font-size: 13px;
        }

        .guarantees {
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid var(--card-border);
            display: flex;
            flex-direction: column;
            gap: 8px;
            font-size: 12px;
            color: #525252;
        }

        .guarantee-line {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .guarantee-line span:first-child {
            color: var(--green);
            font-weight: 700;
        }

        .back-link {
            display: inline-block;
            margin-top: 20px;
            font-size: 12px;
            color: #525252;
            text-decoration: underline;
            text-underline-offset: 4px;
        }

        .back-link:hover { color: var(--ink); }

        .footer {
            background: #111111;
            color: #999999;
            border-top: 1px solid #262626;
            padding: 36px 24px;
            margin-top: auto;
        }

        .footer-inner {
            max-width: 1280px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            font-size: 12px;
        }

        .footer-links {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        .footer-links a:hover { color: #ffffff; }

        @media (max-width: 960px) {
            .nav { display: none; }
            .pdp-grid { grid-template-columns: 1fr; gap: 28px; }
            .purchase-panel { position: static; }
            .thumb-btn { flex: 0 0 74px; }
            .lightbox-stage { padding: 16px 12px; }
        }
    </style>
</head>
<body data-cid="<%= cid %>">
    <%- include('partials/site-header') %>

    <main class="main-wrap">
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Archive</a>
            <span>/</span>
            <a href="/?category=<%= encodeURIComponent(product.category) %>"><%= product.category %></a>
            <span>/</span>
            <span class="current"><%= product.title %></span>
        </nav>

        <article class="pdp-grid">
            <% const galleryImages = (product.images && product.images.length) ? product.images : [product.image]; %>
            <div class="artwork-gallery">
                <div class="artwork-frame" id="artworkFrame">
                    <span class="artwork-tag">Original Work</span>

                    <div class="gallery-tools">
                        <button type="button" class="gallery-tool-btn" id="inlineZoomBtn" aria-pressed="false" title="Toggle 2.2x surface zoom">
                            <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 8v6M8 11h6M19 11a8 8 0 11-16 0 8 8 0 0116 0z"/>
                            </svg>
                            <span id="inlineZoomLabel">Zoom 2.2×</span>
                        </button>
                        <button type="button" class="gallery-tool-btn" id="openLightboxBtn" title="Open full-screen zoom gallery">
                            <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4h4M20 8V4h-4M4 16v4h4M20 16v4h-4"/>
                            </svg>
                            <span>Expand</span>
                        </button>
                    </div>

                    <% if (galleryImages.length > 1) { %>
                    <button type="button" class="gallery-nav-btn prev" id="prevImgBtn" aria-label="Previous image">
                        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                        </svg>
                    </button>
                    <button type="button" class="gallery-nav-btn next" id="nextImgBtn" aria-label="Next image">
                        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </button>
                    <% } %>

                    <img id="mainProductImg" src="<%= galleryImages[0] %>" alt="<%= product.title %> by <%= product.artist %>" loading="eager" referrerPolicy="no-referrer">

                    <span class="zoom-hint" id="zoomHint">Click artwork to expand &amp; zoom</span>
                    <span class="view-counter" id="viewCounter">View 1 of <%= galleryImages.length %></span>
                </div>

                <% if (galleryImages.length > 1) { %>
                <div class="thumb-strip" id="thumbStrip" role="list" aria-label="Artwork gallery views">
                    <% galleryImages.forEach((imgSrc, idx) => { %>
                    <button
                        type="button"
                        class="thumb-btn <%= idx === 0 ? 'active' : '' %>"
                        data-src="<%= imgSrc %>"
                        data-index="<%= idx %>"
                        aria-label="View <%= idx + 1 %> of <%= galleryImages.length %>"
                    >
                        <img src="<%= imgSrc %>" alt="<%= product.title %> view <%= idx + 1 %>" loading="lazy" referrerPolicy="no-referrer" />
                    </button>
                    <% }) %>
                </div>
                <% } %>
            </div>

            <section class="purchase-panel" aria-labelledby="product-title">
                <p class="pdp-artist">
                    <a href="/artists/<%= getArtistSlug(product.artist) %>" style="text-decoration: underline; text-underline-offset: 4px;" title="Read biography &amp; history of <%= product.artist %>"><%= product.artist %> · Biography →</a>
                </p>
                <h1 class="pdp-title" id="product-title"><%= product.title %></h1>

                <div class="pdp-price-row">
                    <span class="pdp-price">$<%= formatCurrency(product.price) %></span>
                    <% if (product.status === 'sold') { %>
                        <span class="pdp-avail" style="color: #525252;">Acquired · Sold Archive</span>
                    <% } else { %>
                        <span class="pdp-avail">In Stock · Ready to Ship</span>
                    <% } %>
                </div>

                <p class="pdp-desc"><%= product.description %></p>

                <div class="specs-grid">
                    <div>
                        <span class="spec-label">Inventory ID</span>
                        <span class="spec-val" style="font-family: var(--font-mono); font-size: 12.5px;"><%= product.inventory_id %></span>
                    </div>
                    <div>
                        <span class="spec-label">Discipline</span>
                        <span class="spec-val"><%= product.category %></span>
                    </div>
                    <div>
                        <span class="spec-label">Dimensions</span>
                        <span class="spec-val"><%= product.size %></span>
                    </div>
                    <% if (typeof provenance !== 'undefined' && provenance) { %>
                    <div>
                        <span class="spec-label">Date / Period</span>
                        <span class="spec-val"><%= provenance.datePeriod %></span>
                    </div>
                    <div style="grid-column: 1 / -1;">
                        <span class="spec-label">Origin / Attribution</span>
                        <span class="spec-val"><%= provenance.originAttribution %></span>
                    </div>
                    <% } %>
                </div>

                <% if (typeof provenance !== 'undefined' && provenance) { %>
                <div class="provenance-dossier" aria-label="Authenticity and provenance dossier">
                    <div class="provenance-dossier-head">
                        <h2 class="provenance-dossier-title">Provenance &amp; Authenticity Dossier</h2>
                        <a href="/certificate/<%= encodeURIComponent(product.inventory_id) %>" class="provenance-badge" style="<%= product.authenticity_status !== 'verified' ? 'color: #92400e;' : '' %>">
                            <% if (product.authenticity_status === 'verified') { %>
                                COA Verified →
                            <% } else if (product.authenticity_status === 'unverified') { %>
                                Unverified · View Record →
                            <% } else { %>
                                Auth Pending Review →
                            <% } %>
                        </a>
                    </div>
                    <div class="provenance-list">
                        <div class="provenance-row">
                            <span class="provenance-key">Inventory ID</span>
                            <span style="font-family: var(--font-mono); font-size: 12px;"><%= product.inventory_id %></span>
                        </div>
                        <div class="provenance-row">
                            <span class="provenance-key">Materials</span>
                            <span><%= provenance.materialsMedium %></span>
                        </div>
                        <div class="provenance-row">
                            <span class="provenance-key">Markings</span>
                            <span><%= provenance.markingsEdition %></span>
                        </div>
                        <div class="provenance-row">
                            <span class="provenance-key">Condition</span>
                            <span><%= provenance.conditionNote %></span>
                        </div>
                        <div class="provenance-row">
                            <span class="provenance-key">Provenance</span>
                            <span><%= provenance.provenanceRecord %></span>
                        </div>
                    </div>
                </div>
                <% } %>

                <% if (messages && messages.length) { %>
                    <% messages.forEach((message) => { %>
                        <div class="flash" role="status"><%= message %></div>
                    <% }) %>
                <% } %>

                <% if (product.status === 'sold') { %>
                <div class="provenance-dossier" style="margin-bottom: 20px; border-color: #d4d4d4; background: #f8f7f4;">
                    <p style="margin: 0 0 10px; font-size: 13px; color: #262626; line-height: 1.6;">
                        This work has been acquired and remains cataloged under Inventory ID <strong style="font-family: var(--font-mono);"><%= product.inventory_id %></strong>.
                    </p>
                    <a href="/certificate/<%= encodeURIComponent(product.inventory_id) %>" style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; text-decoration: underline; text-underline-offset: 4px;">View Artwork Documentation &amp; Certificate →</a>
                </div>
                <% } else { %>
                <form class="add-cart-form" action="/add-to-cart" method="POST">
                    <input type="hidden" name="product_id" value="<%= product.id %>">
                    <div class="qty-field">
                        <label for="quantity">Qty</label>
                        <input id="quantity" type="number" name="quantity" value="1" min="1" max="20" required>
                    </div>
                    <button class="add-btn" type="submit">Add to Bag</button>
                </form>
                <% } %>

                <div class="guarantees">
                    <div class="guarantee-line"><span>✓</span><span>Direct on-chain settlement via BTC, ETH, or SOL</span></div>
                    <div class="guarantee-line">
                        <span>✓</span>
                        <a href="/shipping" style="text-decoration: underline; text-underline-offset: 3px;">
                            <% if (product.category === 'Furniture') { %>
                                White-glove insured furniture crating &amp; worldwide delivery (<%= product.price >= 1500 ? 'complimentary' : 'complimentary $1,500+' %>)
                            <% } else { %>
                                Insured worldwide fine art courier (<%= product.price >= 1500 ? 'complimentary on this piece' : '$65 flat · complimentary $1,500+' %>)
                            <% } %>
                        </a>
                    </div>
                    <div class="guarantee-line">
                        <span>✓</span>
                        <a href="/certificate/<%= encodeURIComponent(product.inventory_id) %>" style="text-decoration: underline; text-underline-offset: 3px;">
                            Artwork Documentation &amp; Certificate (<%= product.inventory_id %>)
                        </a>
                    </div>
                </div>

                <a class="back-link" href="/">← Return to Complete Archive</a>
            </section>
        </article>
    </main>

    <!-- Full-Screen Zoom Lightbox -->
    <div class="lightbox" id="galleryLightbox" role="dialog" aria-modal="true" aria-label="Full-screen artwork inspection">
        <div class="lightbox-bar">
            <div class="lightbox-meta">
                <span class="lightbox-title"><%= product.title %></span>
                <span class="lightbox-counter" id="lbCounter">View 1 of <%= galleryImages.length %></span>
            </div>
            <div class="lightbox-controls">
                <button type="button" class="lb-btn" id="lbZoomOut" aria-label="Zoom out">−</button>
                <button type="button" class="lb-btn" id="lbZoomLevel" aria-label="Reset zoom">100%</button>
                <button type="button" class="lb-btn" id="lbZoomIn" aria-label="Zoom in">+</button>
                <button type="button" class="lb-btn" id="lbClose" aria-label="Close gallery">Close</button>
            </div>
        </div>

        <div class="lightbox-stage" id="lbStage">
            <% if (galleryImages.length > 1) { %>
            <button type="button" class="lb-arrow prev" id="lbPrev" aria-label="Previous image">
                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
            </button>
            <button type="button" class="lb-arrow next" id="lbNext" aria-label="Next image">
                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </button>
            <% } %>
            <img id="lbImg" src="<%= galleryImages[0] %>" alt="<%= product.title %> high-resolution view" referrerPolicy="no-referrer">
        </div>

        <% if (galleryImages.length > 1) { %>
        <div class="lightbox-thumbs" id="lbThumbs">
            <% galleryImages.forEach((imgSrc, idx) => { %>
            <button type="button" class="lb-thumb <%= idx === 0 ? 'active' : '' %>" data-index="<%= idx %>" aria-label="Inspect view <%= idx + 1 %>">
                <img src="<%= imgSrc %>" alt="Thumbnail <%= idx + 1 %>" referrerPolicy="no-referrer" />
            </button>
            <% }) %>
        </div>
        <% } %>
    </div>

    <footer class="footer">
        <div class="footer-inner">
            <span>© 2026 ART STUDIO. All rights reserved.</span>
            <nav class="footer-links" aria-label="Footer policies">
                <a href="/artists">Meet the Artists</a>
                <a href="/shipping">Shipping &amp; Delivery</a>
                <a href="/authenticity">Authenticity</a>
                <a href="/crypto-checkout">Crypto Checkout</a>
                <a href="/terms">Terms</a>
                <a href="/privacy-policy">Privacy Policy</a>
                <a href="/contact">Contact &amp; Support</a>
            </nav>
        </div>
    </footer>

    <script>
        (() => {
            const images = <%- JSON.stringify(galleryImages) %>;
            const total = images.length;
            let activeIndex = 0;

            const artworkFrame = document.getElementById('artworkFrame');
            const mainImg = document.getElementById('mainProductImg');
            const viewCounter = document.getElementById('viewCounter');
            const zoomHint = document.getElementById('zoomHint');
            const inlineZoomBtn = document.getElementById('inlineZoomBtn');
            const inlineZoomLabel = document.getElementById('inlineZoomLabel');
            const openLightboxBtn = document.getElementById('openLightboxBtn');
            const prevImgBtn = document.getElementById('prevImgBtn');
            const nextImgBtn = document.getElementById('nextImgBtn');
            const thumbBtns = Array.from(document.querySelectorAll('.thumb-btn'));

            const lightbox = document.getElementById('galleryLightbox');
            const lbImg = document.getElementById('lbImg');
            const lbStage = document.getElementById('lbStage');
            const lbCounter = document.getElementById('lbCounter');
            const lbZoomIn = document.getElementById('lbZoomIn');
            const lbZoomOut = document.getElementById('lbZoomOut');
            const lbZoomLevel = document.getElementById('lbZoomLevel');
            const lbClose = document.getElementById('lbClose');
            const lbPrev = document.getElementById('lbPrev');
            const lbNext = document.getElementById('lbNext');
            const lbThumbs = Array.from(document.querySelectorAll('.lb-thumb'));

            let inlineZoomed = false;
            let lbScale = 1;
            let lbPanX = 0;
            let lbPanY = 0;
            let dragging = false;
            let dragMoved = false;
            let dragStartX = 0;
            let dragStartY = 0;
            let panStartX = 0;
            let panStartY = 0;

            function setInlineZoom(enabled) {
                inlineZoomed = enabled;
                if (!artworkFrame || !mainImg) return;
                artworkFrame.classList.toggle('inline-zoomed', enabled);
                if (inlineZoomBtn) {
                    inlineZoomBtn.classList.toggle('active', enabled);
                    inlineZoomBtn.setAttribute('aria-pressed', enabled ? 'true' : 'false');
                }
                if (inlineZoomLabel) {
                    inlineZoomLabel.textContent = enabled ? 'Reset Zoom' : 'Zoom 2.2×';
                }
                if (zoomHint) {
                    zoomHint.textContent = enabled
                        ? 'Move cursor to inspect · Click to reset'
                        : 'Click artwork to expand & zoom';
                }
                if (!enabled) {
                    mainImg.style.transformOrigin = 'center center';
                }
            }

            function selectImage(index) {
                if (total <= 0) return;
                activeIndex = ((index % total) + total) % total;
                const src = images[activeIndex];
                if (mainImg) mainImg.src = src;
                if (lbImg) lbImg.src = src;
                if (viewCounter) viewCounter.textContent = `View ${activeIndex + 1} of ${total}`;
                if (lbCounter) lbCounter.textContent = `View ${activeIndex + 1} of ${total}`;

                thumbBtns.forEach((btn, idx) => {
                    const isAct = idx === activeIndex;
                    btn.classList.toggle('active', isAct);
                    if (isAct) {
                        btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
                    }
                });
                lbThumbs.forEach((btn, idx) => btn.classList.toggle('active', idx === activeIndex));
                resetLightboxZoom();
            }

            function applyLightboxTransform() {
                if (!lbImg || !lbStage) return;
                if (lbScale <= 1) {
                    lbScale = 1;
                    lbPanX = 0;
                    lbPanY = 0;
                }
                lbImg.style.transform = `translate(${lbPanX}px, ${lbPanY}px) scale(${lbScale})`;
                lbStage.classList.toggle('is-zoomed', lbScale > 1);
                if (lbZoomLevel) {
                    lbZoomLevel.textContent = `${Math.round(lbScale * 100)}%`;
                }
            }

            function resetLightboxZoom() {
                lbScale = 1;
                lbPanX = 0;
                lbPanY = 0;
                applyLightboxTransform();
            }

            function setLightboxZoom(nextScale) {
                lbScale = Math.min(3.5, Math.max(1, Number(nextScale.toFixed(2))));
                if (lbScale === 1) {
                    lbPanX = 0;
                    lbPanY = 0;
                }
                applyLightboxTransform();
            }

            function openLightbox() {
                if (!lightbox) return;
                setInlineZoom(false);
                lightbox.classList.add('open');
                document.body.style.overflow = 'hidden';
                resetLightboxZoom();
            }

            function closeLightbox() {
                if (!lightbox) return;
                lightbox.classList.remove('open');
                document.body.style.overflow = '';
                resetLightboxZoom();
            }

            thumbBtns.forEach((btn) => {
                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    selectImage(Number(btn.dataset.index || 0));
                });
            });

            lbThumbs.forEach((btn) => {
                btn.addEventListener('click', () => {
                    selectImage(Number(btn.dataset.index || 0));
                });
            });

            if (prevImgBtn) {
                prevImgBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    selectImage(activeIndex - 1);
                });
            }
            if (nextImgBtn) {
                nextImgBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    selectImage(activeIndex + 1);
                });
            }

            if (inlineZoomBtn) {
                inlineZoomBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    setInlineZoom(!inlineZoomed);
                });
            }

            if (openLightboxBtn) {
                openLightboxBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    openLightbox();
                });
            }

            if (artworkFrame) {
                artworkFrame.addEventListener('mousemove', (e) => {
                    if (!inlineZoomed || !mainImg) return;
                    const rect = artworkFrame.getBoundingClientRect();
                    const xPct = Math.max(0, Math.min(100, ((e.clientX - rect.left) / rect.width) * 100));
                    const yPct = Math.max(0, Math.min(100, ((e.clientY - rect.top) / rect.height) * 100));
                    mainImg.style.transformOrigin = `${xPct.toFixed(1)}% ${yPct.toFixed(1)}%`;
                });

                artworkFrame.addEventListener('click', () => {
                    if (inlineZoomed) {
                        setInlineZoom(false);
                    } else {
                        openLightbox();
                    }
                });
            }

            if (lbClose) lbClose.addEventListener('click', closeLightbox);
            if (lbPrev) lbPrev.addEventListener('click', (e) => { e.stopPropagation(); selectImage(activeIndex - 1); });
            if (lbNext) lbNext.addEventListener('click', (e) => { e.stopPropagation(); selectImage(activeIndex + 1); });
            if (lbZoomIn) lbZoomIn.addEventListener('click', () => setLightboxZoom(lbScale + 0.75));
            if (lbZoomOut) lbZoomOut.addEventListener('click', () => setLightboxZoom(lbScale - 0.75));
            if (lbZoomLevel) lbZoomLevel.addEventListener('click', resetLightboxZoom);

            if (lbStage) {
                lbStage.addEventListener('wheel', (e) => {
                    if (!lightbox.classList.contains('open')) return;
                    e.preventDefault();
                    setLightboxZoom(lbScale + (e.deltaY < 0 ? 0.35 : -0.35));
                }, { passive: false });

                lbStage.addEventListener('mousedown', (e) => {
                    if (e.target.closest('.lb-arrow')) return;
                    dragMoved = false;
                    if (lbScale <= 1) return;
                    dragging = true;
                    dragStartX = e.clientX;
                    dragStartY = e.clientY;
                    panStartX = lbPanX;
                    panStartY = lbPanY;
                    lbStage.classList.add('is-dragging');
                });

                window.addEventListener('mousemove', (e) => {
                    if (!dragging) return;
                    const dx = e.clientX - dragStartX;
                    const dy = e.clientY - dragStartY;
                    if (Math.abs(dx) > 4 || Math.abs(dy) > 4) dragMoved = true;
                    lbPanX = panStartX + dx;
                    lbPanY = panStartY + dy;
                    applyLightboxTransform();
                });

                window.addEventListener('mouseup', () => {
                    if (!dragging) return;
                    dragging = false;
                    if (lbStage) lbStage.classList.remove('is-dragging');
                });

                lbStage.addEventListener('click', (e) => {
                    if (e.target.closest('.lb-arrow')) return;
                    if (dragMoved) {
                        dragMoved = false;
                        return;
                    }
                    if (e.target === lbStage) {
                        closeLightbox();
                        return;
                    }
                    setLightboxZoom(lbScale > 1 ? 1 : 2.25);
                });
            }

            document.addEventListener('keydown', (e) => {
                const isOpen = lightbox && lightbox.classList.contains('open');
                if (e.key === 'ArrowLeft') {
                    if (isOpen || document.activeElement?.tagName !== 'INPUT') {
                        selectImage(activeIndex - 1);
                    }
                } else if (e.key === 'ArrowRight') {
                    if (isOpen || document.activeElement?.tagName !== 'INPUT') {
                        selectImage(activeIndex + 1);
                    }
                } else if (isOpen && e.key === 'Escape') {
                    closeLightbox();
                } else if (isOpen && (e.key === '+' || e.key === '=')) {
                    setLightboxZoom(lbScale + 0.75);
                } else if (isOpen && e.key === '-') {
                    setLightboxZoom(lbScale - 0.75);
                }
            });
        })();
    </script>
    <script src="/static/js/cart-sync.js"></script>
</body>
</html>
